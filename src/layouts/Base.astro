---
const { title = "Buskai.net — Encontre e compare ferramentas de IA para LATAM", description, canonicalUrl } = Astro.props;
---
<!DOCTYPE html>
<html lang="pt-BR">
  <head>
    <!-- Google Tag Manager -->
    <script is:inline>(function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
})(window,document,'script','dataLayer','GTM-MGVXP6BK');</script>
    <!-- End Google Tag Manager -->
    <script async src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-3858312966776117" crossorigin="anonymous" is:inline></script>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="canonical" href={canonicalUrl ?? new URL(Astro.url.pathname, 'https://www.buskai.net').href} />
    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Buskai.net" />
    <meta property="og:url" content={canonicalUrl ?? new URL(Astro.url.pathname, 'https://www.buskai.net').href} />
    <meta property="og:title" content={title ?? 'Buskai.net — Encontre e compare ferramentas de IA para LATAM'} />
    <meta property="og:description" content={description ?? 'Diretório curado de ferramentas de IA para o mercado brasileiro e LATAM. Compare preços, suporte em português e disponibilidade no Brasil.'} />
    <meta property="og:image" content="https://www.buskai.net/og-image.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:locale" content="pt_BR" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@buskainet" />
    <meta name="twitter:title" content={title ?? 'Buskai.net — Encontre e compare ferramentas de IA para LATAM'} />
    <meta name="twitter:description" content={description ?? 'Diretório curado de ferramentas de IA para o mercado brasileiro e LATAM.'} />
    <meta name="twitter:image" content="https://www.buskai.net/og-image.png" />
    <!-- Apply saved theme before paint to avoid flash -->
    <script is:inline>
      try {
        var s = JSON.parse(localStorage.getItem('buskai_ui_v1') || '{}');
        document.documentElement.dataset.theme = s.theme || 'light';
      } catch (e) { document.documentElement.dataset.theme = 'light'; }
    </script>
    <!-- Critical CSS inlined to paint background + logo on first render (prevents CLS / aurora flash) -->
    <style>
      body {
        background:
          radial-gradient(58% 42% at 18% -2%, rgba(124,92,252,.30), transparent 62%),
          radial-gradient(52% 40% at 74% -4%, rgba(74,134,255,.24), transparent 62%),
          radial-gradient(44% 34% at 98% 2%, rgba(255,108,176,.20), transparent 60%),
          radial-gradient(46% 32% at 48% -6%, rgba(54,214,196,.14), transparent 58%),
          #fbfbfe;
        background-repeat: no-repeat;
        min-height: 100vh;
      }
      .brand .mark { width: 26px; height: 26px; border-radius: 8px; }
    </style>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;600&display=swap" rel="stylesheet" />
    <link rel="stylesheet" href="/buskai.css" />
    <style is:global>
      /* ---- Site-wide primitives on top of buskai.css ---- */
      main { display: block; }
      .nav .icon-btn {
        background: transparent; border: 0; cursor: pointer;
        color: var(--text-dim); padding: 6px; border-radius: 8px;
        display: inline-flex; align-items: center; gap: 6px; flex: none;
        font-family: var(--mono); font-size: 11px;
      }
      .nav .icon-btn:hover { color: var(--text); background: var(--bg-2); }
      .nav .icon-btn kbd { font-family: inherit; font-size: inherit; }
      .nav .theme-toggle { font-size: 14px; line-height: 1; }
      .nav-dd { position: relative; }
      .nav-dd > a { display: inline-flex; align-items: center; gap: 4px; }
      .nav-dd .menu {
        display: none; position: absolute; top: 100%; left: -10px;
        background: var(--bg-2); border: 1px solid var(--line-2); border-radius: 14px;
        padding: 12px; min-width: 240px; z-index: 100; margin-top: 10px;
      }
      .nav-dd .menu::before {
        content: ""; position: absolute; top: -12px; left: 0; right: 0; height: 12px;
      }
      .nav-dd:hover .menu,
      .nav-dd:focus-within .menu { display: block; box-shadow: 0 20px 40px -12px rgba(40,30,90,.28); }
      .nav-dd .menu .hd {
        font-family: var(--mono); font-size: 10px; color: var(--text-dim);
        text-transform: uppercase; letter-spacing: .1em; margin: 0 0 8px; padding: 0 8px;
      }
      .nav-dd .menu a {
        display: block; padding: 7px 8px; font-size: 13px; color: var(--text);
        border-radius: 8px;
      }
      .nav-dd .menu a:hover { background: var(--bg); color: var(--accent); }
      .nav-dd .menu .div { border-top: 1px solid var(--line); margin: 8px 0; }
      .nav-dd .menu a.all { color: var(--accent); font-weight: 500; }

      /* Footer columns */
      .foot-cols {
        margin-top: 80px; padding-top: 32px; border-top: 1px solid var(--line);
        display: grid; grid-template-columns: repeat(3, 1fr); gap: 32px;
      }
      .foot-cols .hd {
        font-family: var(--mono); font-size: 10px; font-weight: 500; color: var(--text-dim);
        text-transform: uppercase; letter-spacing: .12em; margin-bottom: 12px;
      }
      .foot-cols a {
        display: block; font-size: 13px; color: var(--text-dim);
        padding: 3px 0;
      }
      .foot-cols a:hover { color: var(--accent); }
      footer .foot { margin-top: 32px; border-top: 1px dashed var(--line); padding-top: 20px; }

      /* Search modal */
      .gb-modal {
        display: none; position: fixed; inset: 0; z-index: 999;
        background: rgba(10,10,18,.5); backdrop-filter: blur(6px);
      }
      .gb-modal .box {
        position: absolute; top: 12%; left: 50%; transform: translateX(-50%);
        width: 100%; max-width: 680px; padding: 0 20px;
      }
      .gb-modal .panel {
        background: var(--bg-2); border: 1px solid var(--line-2); border-radius: 16px;
        overflow: hidden;
        box-shadow: 0 0 0 6px var(--accent-glow), 0 30px 80px -20px rgba(20,15,60,.45);
      }
      .gb-modal .row1 {
        display: flex; align-items: center; gap: 12px; padding: 16px 20px;
        border-bottom: 1px solid var(--line);
      }
      .gb-modal input {
        flex: 1; background: transparent; border: 0; outline: 0;
        color: var(--text); font-size: 16px; font-family: var(--sans);
      }
      .gb-modal input::placeholder { color: var(--text-dimmer); }
      .gb-modal .go {
        background: var(--accent); color: var(--on-accent); border: 0;
        padding: 8px 16px; border-radius: 10px; font-weight: 600; font-size: 14px;
        cursor: pointer; line-height: 1;
      }
      .gb-modal .go:hover { background: var(--accent-2); }
      .gb-modal .esc {
        font-family: var(--mono); font-size: 11px; color: var(--text-dim);
        border: 1px solid var(--line-2); border-radius: 6px; padding: 3px 6px; cursor: pointer;
        background: var(--bg);
      }
      .gb-modal .chips-row {
        padding: 10px 14px; display: flex; gap: 6px; flex-wrap: wrap;
        border-bottom: 1px solid var(--line);
      }
      .gb-modal .chips-row button {
        background: transparent; border: 1px solid var(--line);
        color: var(--text-dim); padding: 4px 12px; border-radius: 999px;
        font-size: 11px; cursor: pointer; font-family: var(--mono);
      }
      .gb-modal .chips-row button:hover { color: var(--text); border-color: var(--line-2); }
      .gb-modal .spin {
        width: 16px; height: 16px; border: 2px solid var(--accent-glow);
        border-top-color: var(--accent); border-radius: 50%;
        animation: gbspin .8s linear infinite; display: inline-block;
        margin-right: 8px; vertical-align: middle;
      }
      @keyframes gbspin { to { transform: rotate(360deg); } }

      /* Mobile menu */
      .nav .menu-btn { display: none; }
      .mobile-menu {
        display: none; margin-top: 10px;
        background: var(--bg-2); border: 1px solid var(--line-2); border-radius: 16px;
        padding: 14px; box-shadow: 0 20px 40px -12px rgba(40,30,90,.28);
      }
      .mobile-menu.open { display: block; }
      .mobile-menu .hd {
        font-family: var(--mono); font-size: 10px; color: var(--text-dim);
        text-transform: uppercase; letter-spacing: .1em; margin: 0 0 6px; padding: 0 10px;
      }
      .mobile-menu a {
        display: block; padding: 11px 10px; font-size: 14px; color: var(--text);
        border-radius: 8px;
      }
      .mobile-menu a:hover { background: var(--bg); color: var(--accent); }
      .mobile-menu .div { border-top: 1px solid var(--line); margin: 10px 0; }
      .mobile-menu a.cta { color: var(--accent); font-weight: 600; }

      @media (pointer: coarse) {
        #search-kbd { display: none; }
      }
      @media (max-width: 960px) {
        .nav ul { display: none; }
        .nav .menu-btn { display: inline-flex; }
        .foot-cols { grid-template-columns: 1fr; gap: 24px; }
        .foot-cols a { padding: 9px 0; }
      }
      @media (max-width: 640px) {
        .nav { gap: 10px; }
        .nav .submit { display: none; }
        #search-kbd { display: none; }
        .foot { flex-direction: column; gap: 12px; align-items: flex-start; }
      }
    </style>
  </head>
  <body>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-MGVXP6BK" height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->
    <div class="wrap">
      <nav class="nav">
        <a href="/" class="brand">
          <span class="mark"></span>
          <span>Buskai</span>
          <small>.net</small>
        </a>
        <ul>
          <li class="nav-dd">
            <a href="/categories">Categorias <span style="font-size:9px;">▾</span></a>
            <div class="menu">
              <div class="hd">Por característica</div>
              <a href="/ferramentas-ia-gratuitas">Ferramentas gratuitas</a>
              <a href="/ferramentas-ia-brasil">Funciona no Brasil</a>
              <a href="/ferramentas-ia-em-portugues">Suporte em português</a>
              <a href="/ferramentas-ia-aceita-reais">Aceita BRL</a>
              <div class="div"></div>
              <a href="/categories" class="all">Ver todas as categorias →</a>
            </div>
          </li>
          <li><a href="/compare">Comparar</a></li>
          <li><a href="/blog">Blog</a></li>
        </ul>
        <span class="spacer"></span>
        <button class="icon-btn" onclick="openSearch()" title="Buscar" aria-label="Buscar">
          <svg width="15" height="15" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
          <kbd id="search-kbd"></kbd>
        </button>
        <button class="icon-btn theme-toggle" onclick="GB && GB.toggleTheme()" aria-label="Mudar tema">☾</button>
        <a href="/submit" class="submit">＋ Enviar ferramenta</a>
        <button class="icon-btn menu-btn" onclick="toggleMobileMenu()" aria-label="Abrir menu" aria-expanded="false" aria-controls="mobile-menu">
          <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" viewBox="0 0 24 24"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        </button>
      </nav>
      <div id="mobile-menu" class="mobile-menu">
        <a href="/categories">Todas as categorias</a>
        <a href="/compare">Comparar ferramentas</a>
        <a href="/blog">Blog</a>
        <div class="div"></div>
        <div class="hd">Por característica</div>
        <a href="/ferramentas-ia-gratuitas">Ferramentas gratuitas</a>
        <a href="/ferramentas-ia-brasil">Funciona no Brasil</a>
        <a href="/ferramentas-ia-em-portugues">Suporte em português</a>
        <a href="/ferramentas-ia-aceita-reais">Aceita BRL</a>
        <div class="div"></div>
        <a href="/submit" class="cta">＋ Enviar ferramenta</a>
      </div>
      <main>
        <slot />
      </main>
      <footer>
        <div class="foot-cols">
          <div>
            <div class="hd">Ferramentas por tipo</div>
            <a href="/ferramentas-ia-gratuitas">Ferramentas gratuitas</a>
            <a href="/ferramentas-ia-brasil">Funciona no Brasil</a>
            <a href="/ferramentas-ia-em-portugues">Suporte em português</a>
            <a href="/ferramentas-ia-aceita-reais">Aceita BRL</a>
          </div>
          <div>
            <div class="hd">Por setor</div>
            <a href="/ferramentas-marketing-ia-brasil">Marketing com IA</a>
            <a href="/ferramentas-vendas-ia-brasil">Vendas com IA</a>
            <a href="/ferramentas-suporte-ia-brasil">Suporte com IA</a>
            <a href="/ferramentas-rh-ia-brasil">RH com IA</a>
            <a href="/ferramentas-produtividade-ia-brasil">Produtividade com IA</a>
            <a href="/ferramentas-crm-ia-gratis">CRM gratuito</a>
          </div>
          <div>
            <div class="hd">Buskai</div>
            <a href="/categories">Todas as categorias</a>
            <a href="/compare">Comparar ferramentas</a>
            <a href="/blog">Blog</a>
            <a href="/submit">Enviar ferramenta</a>
            <a href="/sobre">Sobre</a>
            <a href="/contato">Contato</a>
            <a href="/privacidade">Privacidade</a>
            <a href="/termos">Termos</a>
          </div>
        </div>
        <div class="foot">
          <span>© 2026 Buskai.net — Ferramentas de IA para LATAM</span>
          <ul>
            <li>Feito com ☕ no Brasil</li>
          </ul>
        </div>
      </footer>
    </div>

    <!-- Search Modal -->
    <div id="search-modal" class="gb-modal" role="dialog" aria-modal="true" aria-label="Buscar ferramentas" onclick="closeSearch(event)">
      <div class="box">
        <div class="panel">
          <div class="row1">
            <svg width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" style="color:var(--text-dim);flex:none;"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
            <input id="modal-query" type="text" placeholder="Buscar ferramentas de IA para LATAM..." />
            <button onclick="runModalSearch()" id="modal-btn" class="go">Buscar</button>
            <span class="esc" onclick="closeSearchDirect()">ESC</span>
          </div>
          <div class="chips-row">
            <button onclick="setModalQuery('SDR em PT-BR')">SDR em PT-BR</button>
            <button onclick="setModalQuery('Copiloto de CRM')">Copiloto de CRM</button>
            <button onclick="setModalQuery('Marketing gratis')">Marketing gratuito</button>
            <button onclick="setModalQuery('Recrutamento RH')">Recrutamento RH</button>
          </div>
          <div id="modal-loading" style="display:none;padding:32px;text-align:center;color:var(--text-dim);font-size:13px;font-family:var(--mono);">
            <div class="spin"></div>
            Analisando ferramentas...
          </div>
          <div id="modal-results" style="max-height:400px;overflow-y:auto;"></div>
        </div>
      </div>
    </div>

    <script src="/buskai.js" is:inline></script>
    <script is:inline>
      if (window.GB) GB.init();
      document.getElementById('search-kbd').textContent =
        navigator.platform.includes('Mac') ? '⌘K' : 'Ctrl+K';
    </script>
    <script is:inline>
      function toggleMobileMenu() {
        var menu = document.getElementById('mobile-menu');
        var btn = document.querySelector('.nav .menu-btn');
        var open = menu.classList.toggle('open');
        btn.setAttribute('aria-expanded', open ? 'true' : 'false');
        btn.setAttribute('aria-label', open ? 'Fechar menu' : 'Abrir menu');
      }
      var searchOpenerEl = null;
      function openSearch() {
        searchOpenerEl = document.activeElement;
        document.getElementById('search-modal').style.display = 'block';
        document.body.style.overflow = 'hidden';
        setTimeout(() => document.getElementById('modal-query').focus(), 100);
      }
      function closeSearchDirect() {
        document.getElementById('search-modal').style.display = 'none';
        document.body.style.overflow = '';
        document.getElementById('modal-results').innerHTML = '';
        document.getElementById('modal-query').value = '';
        if (searchOpenerEl && searchOpenerEl.focus) searchOpenerEl.focus();
        searchOpenerEl = null;
      }
      function closeSearch(e) {
        if (e.target === document.getElementById('search-modal')) closeSearchDirect();
      }
      function setModalQuery(q) {
        document.getElementById('modal-query').value = q;
        document.getElementById('modal-query').focus();
      }
      document.addEventListener('keydown', function(e) {
        if ((e.metaKey || e.ctrlKey) && e.key === 'k') {
          e.preventDefault();
          openSearch();
        }
        if (e.key === 'Escape') closeSearchDirect();
        if (e.key === 'Tab') {
          var modal = document.getElementById('search-modal');
          if (modal.style.display !== 'block') return;
          var focusables = Array.prototype.filter.call(
            modal.querySelectorAll('a[href], button:not([disabled]), input, [tabindex]:not([tabindex="-1"])'),
            function(el) { return el.offsetParent !== null; }
          );
          if (!focusables.length) return;
          var first = focusables[0];
          var last = focusables[focusables.length - 1];
          if (e.shiftKey && document.activeElement === first) {
            e.preventDefault(); last.focus();
          } else if (!e.shiftKey && document.activeElement === last) {
            e.preventDefault(); first.focus();
          } else if (!modal.contains(document.activeElement)) {
            e.preventDefault(); first.focus();
          }
        }
      });
      document.addEventListener('DOMContentLoaded', function() {
        document.getElementById('modal-query').addEventListener('keydown', function(e) {
          if (e.key === 'Enter') runModalSearch();
        });
      });
      function elWithStyle(tag, style, text) {
        var el = document.createElement(tag);
        if (style) el.setAttribute('style', style);
        if (text != null) el.textContent = String(text);
        return el;
      }
      function safeSlug(slug) {
        // allow only slug-safe characters for the internal tool link
        return String(slug || '').replace(/[^a-zA-Z0-9_-]/g, '');
      }
      function runModalSearch() {
        var query = document.getElementById('modal-query').value.trim();
        if (!query) return;
        var resultsEl = document.getElementById('modal-results');
        resultsEl.innerHTML = '';
        document.getElementById('modal-loading').style.display = 'block';
        document.getElementById('modal-btn').disabled = true;
        fetch('/api/search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query })
        }).then(function(res) {
          return res.json();
        }).then(function(data) {
          document.getElementById('modal-loading').style.display = 'none';
          if (!data || !Array.isArray(data.tools)) throw new Error('bad response');
          resultsEl.innerHTML = '';

          resultsEl.appendChild(elWithStyle('div',
            'padding:12px 20px;font-size:11px;color:var(--text-dimmer);font-family:var(--mono);',
            data.tools.length + ' ferramentas para "' + query + '"'));
          resultsEl.appendChild(elWithStyle('div',
            'font-size:13px;color:var(--text-dim);line-height:1.5;padding:8px 20px;',
            data.reasoning || ''));

          data.tools.forEach(function(tool, i) {
            var a = document.createElement('a');
            a.setAttribute('href', '/tools/' + safeSlug(tool.slug));
            a.setAttribute('onclick', 'closeSearchDirect()');
            a.setAttribute('style', 'display:flex;justify-content:space-between;align-items:center;padding:12px 20px;text-decoration:none;border-top:1px solid var(--line);');

            var left = document.createElement('div');
            var titleRow = elWithStyle('div', 'display:flex;align-items:center;gap:8px;margin-bottom:4px;');
            titleRow.appendChild(elWithStyle('span', 'font-size:11px;color:var(--accent);font-family:var(--mono);', '#' + (i + 1)));
            titleRow.appendChild(elWithStyle('span', 'font-size:14px;font-weight:600;color:var(--text);', tool.name));
            if (tool.works_in_brazil) {
              titleRow.appendChild(elWithStyle('span', 'font-size:10px;padding:1px 6px;background:rgba(74,134,255,.12);color:#4a86ff;border-radius:20px;font-family:var(--mono);', 'BR'));
            }
            if (tool.has_free_plan) {
              titleRow.appendChild(elWithStyle('span', 'font-size:10px;padding:1px 6px;background:var(--accent-glow);color:var(--accent);border-radius:20px;font-family:var(--mono);', 'Grátis'));
            }
            left.appendChild(titleRow);
            left.appendChild(elWithStyle('div', 'font-size:12px;color:var(--text-dim);font-style:italic;', tool.reason));
            a.appendChild(left);

            a.appendChild(elWithStyle('div', 'font-size:13px;font-weight:600;color:var(--text);margin-left:16px;flex-shrink:0;font-family:var(--mono);', tool.price));
            resultsEl.appendChild(a);
          });

          var footer = elWithStyle('div', 'padding:12px 20px;border-top:1px solid var(--line);text-align:center;');
          var fullLink = elWithStyle('a', 'font-size:12px;color:var(--accent);text-decoration:none;font-family:var(--mono);', 'Ver página completa →');
          fullLink.setAttribute('href', '/search?q=' + encodeURIComponent(query));
          footer.appendChild(fullLink);
          resultsEl.appendChild(footer);

          document.getElementById('modal-btn').disabled = false;
        }).catch(function(e) {
          document.getElementById('modal-loading').style.display = 'none';
          resultsEl.innerHTML = '';
          resultsEl.appendChild(elWithStyle('div', 'padding:20px;text-align:center;color:var(--red);font-size:13px;', 'Erro ao buscar. Tente novamente.'));
          document.getElementById('modal-btn').disabled = false;
        });
      }
    </script>
  </body>
</html>
