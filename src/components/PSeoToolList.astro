---
import Base from '../layouts/Base.astro';

const { title, description, heading, intro, breadcrumb, tools = [] } = Astro.props;

const currencySymbol = (c) => c === 'BRL' ? 'R$' : c === 'EUR' ? '€' : '$';
const siteUrl = new URL(Astro.url).origin;

function priceLabel(tool) {
  const sym = currencySymbol(tool.currency);
  const price = tool.starting_price_usd;
  if (tool.has_free_plan && price === 0) return 'Gratuito';
  if (tool.has_free_plan && price > 0) return `Freemium · A partir de ${sym}${price}/mês`;
  if (!tool.has_free_plan && price) return `A partir de ${sym}${price}/mês`;
  return 'Consultar preço';
}

const schema = {
  "@context": "https://schema.org",
  "@type": "ItemList",
  "name": title,
  "description": description,
  "numberOfItems": tools.length,
  "itemListElement": tools.map((t, i) => ({
    "@type": "ListItem",
    "position": i + 1,
    "url": `${siteUrl}/tools/${t.slug}`,
    "name": t.Name,
  })),
};
---

<style>
  .latam-note {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .pseo-logo {
    width: 40px; height: 40px; border-radius: 10px; flex: none;
    display: grid; place-items: center; overflow: hidden;
    font-weight: 800; font-size: 16px; color: #fff;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.08);
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
  }
  .pseo-logo img { width: 100%; height: 100%; object-fit: cover; }
  .pseo-logo .fb { display: grid; place-items: center; width: 100%; height: 100%; background: linear-gradient(135deg, var(--accent), var(--accent-2)); }
  .pseo-kicker {
    font-family: var(--mono); font-size: 11px; color: var(--accent);
    letter-spacing: .16em; text-transform: uppercase; margin-bottom: 10px; display: block;
  }
  .pseo-card {
    transition: border-color .15s ease, transform .15s ease; background: var(--bg-2);
    padding: 24px; border: 1px solid var(--line); border-radius: 12px;
    display: flex; justify-content: space-between; align-items: flex-start; gap: 16px;
  }
  .pseo-card:hover { border-color: var(--accent); transform: translateY(-1px); }
  .pseo-card .side { text-align: right; margin-left: 24px; flex-shrink: 0; }
  .pseo-card .side .acts { display: flex; gap: 8px; justify-content: flex-end; }
  @media (max-width: 640px) {
    .pseo-card { flex-wrap: wrap; }
    .pseo-card .side {
      text-align: left; margin-left: 0; flex-basis: 100%;
      display: flex; align-items: center; justify-content: space-between; gap: 12px;
    }
    .pseo-card .side > div:first-child { margin-bottom: 0; }
    .pseo-card .side .acts { justify-content: flex-start; }
  }
</style>

<Base title={title} description={description}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />

  <div class="crumb">
    <a href="/">home</a><span class="sep">/</span>
    <span>ferramentas de ia</span><span class="sep">/</span>
    <span class="cur">{breadcrumb}</span>
  </div>

  <span class="pseo-kicker">▲ SELEÇÃO · {tools.length} TOOLS</span>
  <h1 style="font-size:clamp(30px,4vw,44px);font-weight:700;letter-spacing:-.03em;margin-bottom:12px;line-height:1.1;">{heading}</h1>
  <p style="font-size:15px;color:var(--text-dim);margin-bottom:12px;max-width:640px;line-height:1.65;">{intro}</p>
  <p style="font-size:12px;color:var(--text-dim);margin-bottom:24px;font-family:var(--mono);">{tools.length} ferramentas encontradas</p>

  {tools.length === 0 ? (
    <div style="padding:40px;background:var(--bg-2);border-radius:12px;text-align:center;color:var(--text-dim);">
      Nenhuma ferramenta encontrada nesta seleção no momento.
    </div>
  ) : (
    <div style="display:flex;flex-direction:column;gap:16px;">
      {tools.map(tool => {
        const host = (() => { try { return new URL(tool.website).hostname; } catch { return null; } })();
        return (
        <div class="pseo-card">
          <div class="pseo-logo">
            {host && <img src={`https://www.google.com/s2/favicons?domain=${host}&sz=128`} alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />}
            <span class="fb" style={host ? 'display:none;' : ''}>{(tool.Name || '?').charAt(0).toUpperCase()}</span>
          </div>
          <div style="flex:1;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
              <a href={`/tools/${tool.slug}`} style="font-size:16px;font-weight:600;color:var(--text);text-decoration:none;">{tool.Name}</a>
              {tool.works_in_brazil && <span style="font-size:11px;padding:2px 8px;background:rgba(74,134,255,.12);color:#4a86ff;border-radius:20px;">Funciona no BR</span>}
              {tool.has_free_plan && <span style="font-size:11px;padding:2px 8px;background:var(--accent-glow);color:var(--accent);border-radius:20px;">Plano grátis</span>}
              {tool.ai_native === true && <span style="font-size:11px;padding:2px 8px;background:var(--accent-glow);color:var(--accent);border-radius:20px;">AI Native</span>}
            </div>
            <p style="font-size:13px;color:var(--text-dim);margin-bottom:10px;">{tool.tagline_pt || tool.tagline_en}</p>
            {tool.latam_note_pt && (
              <p class="latam-note" style="font-size:11px;color:var(--accent);background:var(--accent-glow);padding:4px 10px;border-radius:6px;display:inline-block;">{tool.latam_note_pt}</p>
            )}
          </div>
          <div class="side">
            <div style="font-size:14px;font-weight:500;margin-bottom:8px;">
              {priceLabel(tool)}
            </div>
            <div class="acts">
              <a href={`/tools/${tool.slug}`} class="btn" style="font-size:12px;padding:6px 12px;">Detalhes</a>
              <a href={tool.affiliate_url || tool.website} target="_blank" rel="noopener noreferrer" class="btn primary" style="font-size:12px;padding:6px 14px;">Visitar →</a>
            </div>
          </div>
        </div>
      );})}
    </div>
  )}

  <div style="margin-top:40px;padding-top:24px;border-top:1px solid var(--line);">
    <a href="/categories" style="font-size:14px;color:var(--accent);font-weight:500;text-decoration:none;">Ver todas as categorias →</a>
  </div>
</Base>
