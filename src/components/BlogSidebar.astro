---
const { currentSlug, currentTags = [] } = Astro.props;

const allPosts = [
  { title: '5 ferramentas de IA que todo empreendedor brasileiro deveria conhecer em 2026', slug: '5-ferramentas-ia-empreendedor-brasileiro', date: '2026-06-08', tags: ['brasil', 'ia-generativa', 'produtividade'] },
  { title: 'ChatGPT vs Gemini vs Claude: qual usar na sua empresa em 2026?', slug: 'chatgpt-vs-gemini-vs-claude', date: '2026-06-08', tags: ['assistentes', 'ia-generativa', 'brasil'] },
  { title: 'Como usar IA para atender clientes sem contratar mais pessoas', slug: 'ia-para-atendimento-ao-cliente', date: '2026-06-08', tags: ['atendimento', 'automacao', 'brasil'] },
  { title: 'IA para pequenas empresas: por onde começar sem gastar muito', slug: 'ia-para-pequenas-empresas', date: '2026-06-08', tags: ['brasil', 'produtividade', 'ia-generativa'] },
  { title: 'Melhores CRMs para pequenas empresas brasileiras em 2026', slug: 'melhores-crms-para-pequenas-empresas-brasileiras', date: '2026-05-12', tags: ['crm', 'vendas', 'brasil'] },
  { title: 'Como automatizar o atendimento no WhatsApp com IA em 2026', slug: 'como-automatizar-atendimento-whatsapp-ia', date: '2026-05-19', tags: ['whatsapp', 'atendimento', 'automacao'] },
  { title: 'Ferramentas de IA para criadores de conteúdo brasileiros em 2026', slug: 'ferramentas-ia-criadores-conteudo-brasil', date: '2026-05-26', tags: ['conteudo', 'criadores', 'video'] },
  { title: 'Como usar IA para gerar leads B2B no Brasil em 2026', slug: 'como-usar-ia-gerar-leads-b2b-brasil', date: '2026-06-02', tags: ['leads', 'vendas', 'b2b'] },
  { title: 'Melhores ferramentas de IA para RH e recrutamento no Brasil em 2026', slug: 'melhores-ferramentas-ia-rh-recrutamento-brasil', date: '2026-06-05', tags: ['rh', 'recrutamento', 'brasil'] },
  { title: 'IA para e-commerce brasileiro: ferramentas para vender mais em 2026', slug: 'ia-para-ecommerce-brasileiro', date: '2026-06-08', tags: ['ecommerce', 'marketing', 'brasil'] },
  { title: 'Como escolher o melhor assistente de IA para sua empresa em 2026', slug: 'como-escolher-assistente-ia-para-sua-empresa', date: '2026-06-10', tags: ['assistentes', 'ia-generativa', 'brasil'] },
  { title: 'Ferramentas de IA para reuniões e produtividade em equipe em 2026', slug: 'ferramentas-ia-reunioes-produtividade', date: '2026-06-11', tags: ['produtividade', 'reunioes', 'equipe'] },
  { title: 'Como criar vídeos com IA sem ser designer em 2026', slug: 'como-criar-videos-com-ia-sem-ser-designer', date: '2026-06-12', tags: ['video', 'conteudo', 'criadores'] },
  { title: 'IA para vendas: como times B2B brasileiros estão usando em 2026', slug: 'ia-para-vendas-times-b2b-brasileiros', date: '2026-06-13', tags: ['vendas', 'b2b', 'crm'] },
];

const formatDate = (dateStr) => {
  const d = new Date(dateStr + 'T00:00:00');
  return d.toLocaleDateString('pt-BR', { month: 'short', year: 'numeric' });
};

const posts = allPosts
  .filter(p => p.slug !== currentSlug)
  .sort((a, b) => new Date(b.date) - new Date(a.date));

const recentPosts = posts.slice(0, 3);
const recentSlugs = new Set(recentPosts.map(p => p.slug));

const relatedPosts = posts
  .filter(p => !recentSlugs.has(p.slug))
  .map(p => ({
    ...p,
    matchCount: p.tags.filter(t => currentTags.includes(t)).length,
  }))
  .filter(p => p.matchCount > 0)
  .sort((a, b) => b.matchCount - a.matchCount)
  .slice(0, 3);
---

<div class="blog-sidebar">
  <div class="sidebar-section">
    <div class="section-title">Recentes</div>
    {recentPosts.map(post => (
      <a href={`/blog/${post.slug}`} class="post-card">
        <span class="post-title">{post.title}</span>
        <span class="post-date">{formatDate(post.date)}</span>
      </a>
    ))}
  </div>

  {relatedPosts.length > 0 && (
    <div class="sidebar-section">
      <div class="section-title">Relacionados</div>
      {relatedPosts.map(post => (
        <a href={`/blog/${post.slug}`} class="post-card">
          <span class="post-title">{post.title}</span>
          <span class="post-meta">{post.matchCount} {post.matchCount === 1 ? 'tag em comum' : 'tags em comum'}</span>
        </a>
      ))}
    </div>
  )}
</div>

<style>
  .blog-sidebar {
    position: sticky;
    top: 80px;
    display: flex;
    flex-direction: column;
    gap: 28px;
  }

  .section-title {
    font-size: 11px;
    font-weight: 700;
    color: #aaa;
    text-transform: uppercase;
    letter-spacing: .08em;
    margin-bottom: 10px;
  }

  .sidebar-section {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .post-card {
    display: flex;
    flex-direction: column;
    gap: 3px;
    padding: 10px 12px;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.15s ease;
    margin-bottom: 4px;
  }

  .post-card:hover {
    background: #f0faf6;
  }

  .post-title {
    font-size: 13px;
    color: #222;
    line-height: 1.45;
    font-weight: 500;
  }

  .post-card:hover .post-title {
    color: #1D9E75;
  }

  .post-date,
  .post-meta {
    font-size: 11px;
    color: #bbb;
  }

  .post-meta {
    color: #1D9E75;
    font-weight: 500;
  }
</style>
