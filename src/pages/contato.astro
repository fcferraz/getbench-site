---
import Base from '../layouts/Base.astro';
---

<Base title="Contato — Buskai.net">
  <div style="max-width:640px;margin:0 auto;">

    <div style="margin-bottom:40px;">
      <div style="display:inline-block;font-size:12px;padding:4px 12px;background:var(--accent-glow);color:var(--accent);border-radius:20px;margin-bottom:20px;">
        Fale conosco
      </div>
      <h1 style="font-size:36px;font-weight:700;line-height:1.2;margin-bottom:16px;">Contato</h1>
      <p style="font-size:16px;color:var(--text-dim);line-height:1.6;">
        Fale com a gente por e-mail. Lemos todas as mensagens e respondemos em até 2 dias úteis.
      </p>
    </div>

    <a
      href="mailto:buskai.net@gmail.com"
      style="display:flex;align-items:center;gap:16px;padding:24px;border:1px solid var(--line-2);border-radius:14px;background:var(--bg-2);text-decoration:none;margin-bottom:40px;"
    >
      <div style="font-size:28px;line-height:1;">✉️</div>
      <div>
        <div style="font-size:12px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.06em;margin-bottom:4px;">E-mail</div>
        <div style="font-size:22px;font-weight:700;color:var(--accent);">buskai.net@gmail.com</div>
      </div>
    </a>

    <div style="margin-bottom:16px;">
      <h2 style="font-size:16px;font-weight:600;color:var(--text);margin-bottom:8px;">Sobre o que falar</h2>
      <p style="font-size:14px;color:var(--text-dim);line-height:1.6;">
        Use o e-mail acima para qualquer um destes casos:
      </p>
    </div>

    <div style="display:flex;flex-direction:column;gap:12px;">
      <div style="display:flex;gap:14px;align-items:flex-start;padding:18px;border:1px solid var(--line);border-radius:12px;">
        <div style="font-size:22px;line-height:1;">🛠</div>
        <div>
          <div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:2px;">Sugestão de ferramenta</div>
          <div style="font-size:13px;color:var(--text-dim);line-height:1.55;">Conhece uma ferramenta de IA que deveria estar no diretório? Manda pra gente avaliar.</div>
        </div>
      </div>
      <div style="display:flex;gap:14px;align-items:flex-start;padding:18px;border:1px solid var(--line);border-radius:12px;">
        <div style="font-size:22px;line-height:1;">🤝</div>
        <div>
          <div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:2px;">Parcerias</div>
          <div style="font-size:13px;color:var(--text-dim);line-height:1.55;">Conteúdo, distribuição, integrações ou outras formas de trabalhar junto.</div>
        </div>
      </div>
      <div style="display:flex;gap:14px;align-items:flex-start;padding:18px;border:1px solid var(--line);border-radius:12px;">
        <div style="font-size:22px;line-height:1;">💬</div>
        <div>
          <div style="font-size:14px;font-weight:600;color:var(--text);margin-bottom:2px;">Dúvidas e correções</div>
          <div style="font-size:13px;color:var(--text-dim);line-height:1.55;">Alguma informação incorreta, bug no site ou qualquer outra pergunta.</div>
        </div>
      </div>
    </div>

  </div>
</Base>
