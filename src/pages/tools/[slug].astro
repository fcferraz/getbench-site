---
import Base from '../../layouts/Base.astro';
import { getToolBySlug } from '../../lib/supabase.js';

const { slug } = Astro.params;
let tool;
try {
  tool = await getToolBySlug(slug);
} catch (err) {
  console.error(`[tools/${slug}] erro ao buscar ferramenta:`, err);
  return Astro.redirect('/categories');
}

if (!tool) {
  return Astro.redirect('/categories');
}

const firstCategory = tool.categories?.[0];
const currencySymbol = (c) => c === 'BRL' ? 'R$' : c === 'EUR' ? '€' : '$';
const sym = currencySymbol(tool.currency);
const pricingLabels = { per_month: 'Mensal', per_user: 'Por usuário', custom: 'Sob consulta' };
const seoDescription = tool.description_pt
  ? tool.description_pt.slice(0, 160)
  : (tool.tagline_pt || tool.tagline_en || '');

const canonicalUrl = `https://www.buskai.net/tools/${slug}`;

const hostOf = (url) => { try { return new URL(url).hostname; } catch { return null; } };
const host = hostOf(tool.website);

const compareMap = {
  'hubspot-crm':          { cat: 'crm-automation',       others: ['pipedrive', 'rd-station-crm'] },
  'hubspot-sales':        { cat: 'crm-automation',       others: ['pipedrive', 'rd-station-crm'] },
  'pipedrive':            { cat: 'crm-automation',       others: ['hubspot-sales', 'rd-station-crm'] },
  'rd-station-crm':      { cat: 'crm-automation',       others: ['pipedrive', 'hubspot-sales'] },
  'moskit':               { cat: 'crm-automation',       others: ['pipedrive', 'rd-station-crm'] },
  'agendor':              { cat: 'crm-automation',       others: ['pipedrive', 'moskit'] },
  'apollo-io':            { cat: 'sales-outreach',       others: ['clay', 'lemlist'] },
  'clay':                 { cat: 'sales-outreach',       others: ['apollo-io', 'instantly'] },
  'lemlist':              { cat: 'sales-outreach',       others: ['instantly', 'apollo-io'] },
  'instantly':            { cat: 'sales-outreach',       others: ['lemlist', 'apollo-io'] },
  'kaspr':                { cat: 'sales-outreach',       others: ['apollo-io', 'clay'] },
  'octadesk':             { cat: 'customer-support',     others: ['tidio', 'chatbase'] },
  'tidio':                { cat: 'customer-support',     others: ['octadesk', 'chatbase'] },
  'reply-chat':           { cat: 'customer-support',     others: ['tidio', 'octadesk'] },
  'chatbase':             { cat: 'customer-support',     others: ['tidio', 'octadesk'] },
  'activecampaign':       { cat: 'marketing-automation', others: ['klaviyo', 'rd-station-marketing'] },
  'klaviyo':              { cat: 'marketing-automation', others: ['activecampaign', 'rd-station-marketing'] },
  'rd-station-marketing': { cat: 'marketing-automation', others: ['activecampaign', 'klaviyo'] },
  'beehiiv':              { cat: 'marketing-automation', others: ['activecampaign', 'klaviyo'] },
  'chatgpt':              { cat: 'assistentes-de-ia',    others: ['claude', 'gemini'] },
  'claude':               { cat: 'assistentes-de-ia',    others: ['chatgpt', 'gemini'] },
  'gemini':               { cat: 'assistentes-de-ia',    others: ['chatgpt', 'claude'] },
  'microsoft-copilot':    { cat: 'assistentes-de-ia',    others: ['chatgpt', 'claude'] },
  'meta-ai':              { cat: 'assistentes-de-ia',    others: ['chatgpt', 'gemini'] },
  'gupy':                 { cat: 'hr-automation',        others: ['kenoby', 'factorial-hr'] },
  'kenoby':               { cat: 'hr-automation',        others: ['gupy', 'factorial-hr'] },
  'taqe':                 { cat: 'hr-automation',        others: ['gupy', 'kenoby'] },
  'solides':              { cat: 'hr-automation',        others: ['factorial-hr', 'gupy'] },
  'factorial-hr':         { cat: 'hr-automation',        others: ['gupy', 'solides'] },
  'canva':                { cat: 'design-com-ia',        others: ['adcreative', 'heygen'] },
  'adcreative':           { cat: 'design-com-ia',        others: ['canva', 'heygen'] },
  'opusclip':             { cat: 'criacao-de-video',     others: ['submagic', 'heygen'] },
  'heygen':               { cat: 'criacao-de-video',     others: ['runway', 'veed'] },
  'runway':               { cat: 'criacao-de-video',     others: ['heygen', 'veed'] },
  'veed':                 { cat: 'criacao-de-video',     others: ['heygen', 'runway'] },
  'pika':                 { cat: 'criacao-de-video',     others: ['runway', 'heygen'] },
  'submagic':             { cat: 'criacao-de-video',     others: ['opusclip', 'veed'] },
  'elevenlabs':           { cat: 'voz-e-texto',          others: ['chatgpt', 'heygen'] },
  'fireflies':            { cat: 'reunioes-com-ia',      others: ['tldv', 'bluedot'] },
  'tldv':                 { cat: 'reunioes-com-ia',      others: ['fireflies', 'bluedot'] },
  'bluedot':              { cat: 'reunioes-com-ia',      others: ['fireflies', 'tldv'] },
  'noty':                 { cat: 'reunioes-com-ia',      others: ['fireflies', 'tldv'] },
  'notion-ai':            { cat: 'produtividade-com-ia', others: ['chatgpt', 'fireflies'] },
  'gong':                 { cat: 'revenue-operations',   others: ['salesloft', 'hubspot-sales'] },
  'salesloft':            { cat: 'revenue-operations',   others: ['gong', 'hubspot-sales'] },
  'funnels':              { cat: 'vendas-com-ia',        others: ['hubspot-sales', 'pipedrive'] },
};
const compareEntry = compareMap[slug];

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": tool.Name,
  "description": tool.description_pt || tool.tagline_pt || tool.tagline_en || '',
  "url": tool.website || '',
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  ...(tool.starting_price_usd === 0 ? {
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  } : tool.starting_price_usd ? {
    "offers": {
      "@type": "Offer",
      "price": String(tool.starting_price_usd),
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "billingDuration": "P1M"
      }
    }
  } : {}),
  ...(tool.works_in_brazil ? { "availableOnDevice": "Web", "countriesSupported": "BR" } : {}),
};
---

<style>
  .latam-note {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tool-logo {
    width: 52px; height: 52px; border-radius: 12px; flex: none;
    display: grid; place-items: center; overflow: hidden;
    font-weight: 800; font-size: 22px; color: #fff;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.08);
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
  }
  .tool-logo img { width: 100%; height: 100%; object-fit: cover; }
  .tool-logo .fb { display: grid; place-items: center; width: 100%; height: 100%; background: linear-gradient(135deg, var(--accent), var(--accent-2)); }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 640px) {
    .two-col { grid-template-columns: 1fr; }
  }
</style>

<Base title={`${tool.Name} — Buskai.net`} description={seoDescription} canonicalUrl={canonicalUrl}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="crumb">
    <a href="/">home</a><span class="sep">/</span>
    {firstCategory && <><a href={`/category/${firstCategory.slug || 'sales-outreach'}`}>{firstCategory.name || 'categorias'}</a><span class="sep">/</span></>}
    <span class="cur">{tool.slug}</span>
  </div>

  <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:32px;flex-wrap:wrap;gap:16px;">
    <div style="display:flex;gap:16px;align-items:flex-start;">
      <div class="tool-logo">
        {host && <img src={`https://www.google.com/s2/favicons?domain=${host}&sz=128`} alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />}
        <span class="fb" style={host ? 'display:none;' : ''}>{(tool.Name || '?').charAt(0).toUpperCase()}</span>
      </div>
      <div>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap;">
        <h1 style="font-size:28px;font-weight:600;letter-spacing:-.02em;">{tool.Name}</h1>
        {tool.works_in_brazil && <span style="font-size:11px;padding:3px 10px;background:rgba(74,134,255,.12);color:#4a86ff;border-radius:20px;">Funciona no BR</span>}
        {tool.has_free_plan && <span style="font-size:11px;padding:3px 10px;background:var(--accent-glow);color:var(--accent);border-radius:20px;">Plano grátis</span>}
        {tool.ai_native === true && <span style="font-size:11px;padding:3px 10px;background:var(--accent-glow);color:var(--accent);border-radius:20px;">AI Native</span>}
      </div>
      <p style="font-size:16px;color:var(--text-dim);max-width:600px;">{tool.tagline_pt || tool.tagline_en}</p>
      </div>
    </div>
    <div style="text-align:right;flex-shrink:0;">
      <div style="font-size:20px;font-weight:600;margin-bottom:8px;">
        {tool.has_free_plan && tool.starting_price_usd === 0 ? 'Plano gratuito disponível' : tool.starting_price_usd ? `A partir de ${sym}${tool.starting_price_usd}/mês` : 'Consultar preço'}
      </div>
      <a href={tool.affiliate_url || tool.website} target="_blank" rel="noopener noreferrer" class="btn primary">
        Acessar {tool.Name} →
      </a>
    </div>
  </div>

  {tool.description_pt && (
    <div style="margin-bottom:32px;padding:24px;border:1px solid var(--line);border-radius:12px;">
      <h2 style="font-size:16px;font-weight:600;margin-bottom:12px;">Sobre {tool.Name}</h2>
      <p style="font-size:14px;color:var(--text);line-height:1.7;">{tool.description_pt}</p>
    </div>
  )}

  <div class="two-col" style="margin-bottom:32px;">
    <div style="padding:20px;border:1px solid var(--line);border-radius:12px;">
      <h2 style="font-size:13px;font-weight:600;margin-bottom:16px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.05em;">Preços</h2>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:var(--text-dim);">Preço inicial</span>
          <span style="font-weight:500;">{tool.has_free_plan && tool.starting_price_usd === 0 ? 'Plano gratuito disponível' : `${sym}${tool.starting_price_usd}/mês`}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:var(--text-dim);">Plano grátis</span>
          <span style="font-weight:500;color:{tool.has_free_plan ? 'var(--accent)' : 'var(--text-dim)'}">{tool.has_free_plan ? '✓ Sim' : '✗ Não'}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:var(--text-dim);">Cobrança</span>
          <span style="font-weight:500;">{pricingLabels[tool.pricing_model] || tool.pricing_model || 'Mensal'}</span>
        </div>
      </div>
    </div>

    <div style="padding:20px;border:1px solid var(--line);border-radius:12px;">
      <h2 style="font-size:13px;font-weight:600;margin-bottom:16px;color:var(--text-dim);text-transform:uppercase;letter-spacing:.05em;">Disponibilidade LATAM</h2>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:var(--text-dim);">Funciona no Brasil</span>
          <span style="font-weight:500;color:{tool.works_in_brazil ? 'var(--accent)' : 'var(--text-dim)'}">{tool.works_in_brazil ? '✓ Sim' : '✗ Não'}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:var(--text-dim);">Funciona no México</span>
          <span style="font-weight:500;color:{tool.works_in_mexico ? 'var(--accent)' : 'var(--text-dim)'}">{tool.works_in_mexico ? '✓ Sim' : '✗ Não'}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:var(--text-dim);">Aceita BRL</span>
          <span style="font-weight:500;color:{tool.accepts_brl ? 'var(--accent)' : 'var(--text-dim)'}">{tool.accepts_brl ? '✓ Sim' : '✗ Não'}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:var(--text-dim);">Suporte PT</span>
          <span style="font-weight:500;color:{tool.has_pt_support ? 'var(--accent)' : 'var(--text-dim)'}">{tool.has_pt_support ? '✓ Sim' : '✗ Não'}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:var(--text-dim);">Dados LATAM</span>
          <span style="font-weight:500;color:{tool.has_latam_data ? 'var(--accent)' : 'var(--text-dim)'}">{tool.has_latam_data ? '✓ Sim' : '✗ Não'}</span>
        </div>
      </div>
    </div>
  </div>

  {tool.latam_note_pt && (
    <div style="margin-bottom:32px;padding:16px 20px;background:var(--accent-glow);border-radius:12px;">
      <h2 style="font-size:13px;font-weight:600;color:var(--accent);margin-bottom:6px;">Nota para o mercado brasileiro</h2>
      <p class="latam-note" style="font-size:13px;color:var(--text-dim);line-height:1.6;">{tool.latam_note_pt}</p>
    </div>
  )}

  {tool.why_we_chose_pt && (
    <div style="margin-bottom:32px;padding:24px 28px;background:color-mix(in oklab, var(--accent-glow) 45%, transparent);border:1px solid var(--line-2);border-radius:12px;">
      <h2 style="font-size:13px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.06em;margin-bottom:10px;">Por que escolhemos</h2>
      <p style="font-size:14px;color:var(--text-dim);line-height:1.75;margin:0;">{tool.why_we_chose_pt}</p>
    </div>
  )}

  {(tool.pros_pt || tool.cons_pt) && (
    <div style="margin-bottom:32px;">
      <h2 style="font-size:13px;font-weight:700;color:var(--text-dim);text-transform:uppercase;letter-spacing:.06em;margin-bottom:16px;">Prós e Contras</h2>
      <div class="two-col">
        {tool.pros_pt && (
          <div style="padding:20px;background:var(--bg-2);border:1px solid var(--line-2);border-radius:12px;">
            <h3 style="font-size:12px;font-weight:700;color:var(--accent);text-transform:uppercase;letter-spacing:.05em;margin-bottom:12px;">Pontos positivos</h3>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;">
              {tool.pros_pt.split('\n').filter(Boolean).map((pro) => (
                <li style="font-size:13px;color:var(--text-dim);line-height:1.5;">{pro}</li>
              ))}
            </ul>
          </div>
        )}
        {tool.cons_pt && (
          <div style="padding:20px;background:var(--bg-2);border:1px solid var(--line-2);border-radius:12px;">
            <h3 style="font-size:12px;font-weight:700;color:var(--red);text-transform:uppercase;letter-spacing:.05em;margin-bottom:12px;">Pontos de atenção</h3>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:8px;">
              {tool.cons_pt.split('\n').filter(Boolean).map((con) => (
                <li style="font-size:13px;color:var(--text-dim);line-height:1.5;">{con}</li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </div>
  )}

  <div style="text-align:center;padding:32px;border:1px solid var(--line);border-radius:12px;background:var(--bg-2);">
    <p style="font-size:15px;color:var(--text-dim);margin-bottom:16px;">Pronto para usar {tool.Name}?</p>
    <a href={tool.affiliate_url || tool.website} target="_blank" rel="noopener noreferrer" class="btn primary">
      Começar com {tool.Name} →
    </a>
  </div>

  {compareEntry && (
    <div style="margin-top:32px;padding:24px;border:1px solid var(--line);border-radius:12px;">
      <h2 style="font-size:14px;font-weight:600;color:var(--text-dim);text-transform:uppercase;letter-spacing:.05em;margin-bottom:16px;">Comparar com outras ferramentas</h2>
      <div style="display:flex;flex-direction:column;gap:10px;">
        {compareEntry.others.map((other) => (
          <a href={`/compare/${compareEntry.cat}/${slug}-vs-${other}`}
            style="display:flex;align-items:center;gap:8px;font-size:14px;color:var(--accent);text-decoration:none;padding:10px 14px;border:1px solid var(--line-2);border-radius:8px;background:var(--bg-2);transition:background 0.15s;">
            {tool.Name} vs {other.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')} →
          </a>
        ))}
      </div>
    </div>
  )}
</Base>
