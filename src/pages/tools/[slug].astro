---
import Base from '../../layouts/Base.astro';
import { getToolBySlug } from '../../lib/airtable.js';

const { slug } = Astro.params;
let tool;
try {
  tool = await getToolBySlug(slug);
} catch (err) {
  console.error(`[tools/${slug}] erro ao buscar ferramenta:`, err);
  return Astro.redirect('/categories');
}

if (!tool) {
  return Astro.redirect('/categories');
}

const firstCategory = tool.categories?.[0];
const currencySymbol = (c) => c === 'BRL' ? 'R$' : c === 'EUR' ? '€' : '$';
const sym = currencySymbol(tool.currency);
const pricingLabels = { per_month: 'Mensal', per_user: 'Por usuário', custom: 'Sob consulta' };
const seoDescription = tool.description_pt
  ? tool.description_pt.slice(0, 160)
  : (tool.tagline_pt || tool.tagline_en || '');

const compareMap = {
  'hubspot-crm':          { cat: 'crm-automation',       others: ['pipedrive', 'rd-station-crm'] },
  'hubspot-sales':        { cat: 'crm-automation',       others: ['pipedrive', 'rd-station-crm'] },
  'pipedrive':            { cat: 'crm-automation',       others: ['hubspot-sales', 'rd-station-crm'] },
  'rd-station-crm':      { cat: 'crm-automation',       others: ['pipedrive', 'hubspot-sales'] },
  'moskit':               { cat: 'crm-automation',       others: ['pipedrive', 'rd-station-crm'] },
  'agendor':              { cat: 'crm-automation',       others: ['pipedrive', 'moskit'] },
  'apollo-io':            { cat: 'sales-outreach',       others: ['clay', 'lemlist'] },
  'clay':                 { cat: 'sales-outreach',       others: ['apollo-io', 'instantly'] },
  'lemlist':              { cat: 'sales-outreach',       others: ['instantly', 'apollo-io'] },
  'instantly':            { cat: 'sales-outreach',       others: ['lemlist', 'apollo-io'] },
  'kaspr':                { cat: 'sales-outreach',       others: ['apollo-io', 'clay'] },
  'octadesk':             { cat: 'customer-support',     others: ['tidio', 'chatbase'] },
  'tidio':                { cat: 'customer-support',     others: ['octadesk', 'chatbase'] },
  'reply-chat':           { cat: 'customer-support',     others: ['tidio', 'octadesk'] },
  'chatbase':             { cat: 'customer-support',     others: ['tidio', 'octadesk'] },
  'activecampaign':       { cat: 'marketing-automation', others: ['klaviyo', 'rd-station-marketing'] },
  'klaviyo':              { cat: 'marketing-automation', others: ['activecampaign', 'rd-station-marketing'] },
  'rd-station-marketing': { cat: 'marketing-automation', others: ['activecampaign', 'klaviyo'] },
  'beehiiv':              { cat: 'marketing-automation', others: ['activecampaign', 'klaviyo'] },
  'chatgpt':              { cat: 'assistentes-de-ia',    others: ['claude', 'gemini'] },
  'claude':               { cat: 'assistentes-de-ia',    others: ['chatgpt', 'gemini'] },
  'gemini':               { cat: 'assistentes-de-ia',    others: ['chatgpt', 'claude'] },
  'microsoft-copilot':    { cat: 'assistentes-de-ia',    others: ['chatgpt', 'claude'] },
  'meta-ai':              { cat: 'assistentes-de-ia',    others: ['chatgpt', 'gemini'] },
  'gupy':                 { cat: 'hr-automation',        others: ['kenoby', 'factorial-hr'] },
  'kenoby':               { cat: 'hr-automation',        others: ['gupy', 'factorial-hr'] },
  'taqe':                 { cat: 'hr-automation',        others: ['gupy', 'kenoby'] },
  'solides':              { cat: 'hr-automation',        others: ['factorial-hr', 'gupy'] },
  'factorial-hr':         { cat: 'hr-automation',        others: ['gupy', 'solides'] },
  'canva':                { cat: 'design-com-ia',        others: ['adcreative', 'heygen'] },
  'adcreative':           { cat: 'design-com-ia',        others: ['canva', 'heygen'] },
  'opusclip':             { cat: 'criacao-de-video',     others: ['submagic', 'heygen'] },
  'heygen':               { cat: 'criacao-de-video',     others: ['runway', 'veed'] },
  'runway':               { cat: 'criacao-de-video',     others: ['heygen', 'veed'] },
  'veed':                 { cat: 'criacao-de-video',     others: ['heygen', 'runway'] },
  'pika':                 { cat: 'criacao-de-video',     others: ['runway', 'heygen'] },
  'submagic':             { cat: 'criacao-de-video',     others: ['opusclip', 'veed'] },
  'elevenlabs':           { cat: 'voz-e-texto',          others: ['chatgpt', 'heygen'] },
  'fireflies':            { cat: 'reunioes-com-ia',      others: ['tldv', 'bluedot'] },
  'tldv':                 { cat: 'reunioes-com-ia',      others: ['fireflies', 'bluedot'] },
  'bluedot':              { cat: 'reunioes-com-ia',      others: ['fireflies', 'tldv'] },
  'noty':                 { cat: 'reunioes-com-ia',      others: ['fireflies', 'tldv'] },
  'notion-ai':            { cat: 'produtividade-com-ia', others: ['chatgpt', 'fireflies'] },
  'gong':                 { cat: 'revenue-operations',   others: ['salesloft', 'hubspot-sales'] },
  'salesloft':            { cat: 'revenue-operations',   others: ['gong', 'hubspot-sales'] },
  'funnels':              { cat: 'vendas-com-ia',        others: ['hubspot-sales', 'pipedrive'] },
};
const compareEntry = compareMap[slug];

const schema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": tool.Name,
  "description": tool.description_pt || tool.tagline_pt || tool.tagline_en || '',
  "url": tool.website || '',
  "applicationCategory": "BusinessApplication",
  "operatingSystem": "Web",
  ...(tool.starting_price_usd === 0 ? {
    "offers": {
      "@type": "Offer",
      "price": "0",
      "priceCurrency": "USD"
    }
  } : tool.starting_price_usd ? {
    "offers": {
      "@type": "Offer",
      "price": String(tool.starting_price_usd),
      "priceCurrency": "USD",
      "priceSpecification": {
        "@type": "UnitPriceSpecification",
        "billingDuration": "P1M"
      }
    }
  } : {}),
  ...(tool.works_in_brazil ? { "availableOnDevice": "Web", "countriesSupported": "BR" } : {}),
};
---

<style>
  .breadcrumb { display: flex; gap: 2px; align-items: center; font-size: 12px; color: #bbb; margin-bottom: 28px; flex-wrap: wrap; letter-spacing: 0.01em; }
  .breadcrumb a { color: #999; text-decoration: none; padding: 2px 4px; border-radius: 4px; transition: color 0.15s ease, background 0.15s ease; }
  .breadcrumb a:hover { color: #1D9E75; background: #f0faf6; }
  .breadcrumb span { color: #ddd; font-size: 10px; margin: 0 1px; user-select: none; }
  .latam-note {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<Base title={`${tool.Name} — Buskai.net`} description={seoDescription}>
  <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  <div class="breadcrumb">
    <a href="/">Início</a><span>›</span>
    {firstCategory && <><a href={`/category/${firstCategory.slug || 'sales-outreach'}`}>{firstCategory.name || 'Categorias'}</a><span>›</span></>}
    {tool.Name}
  </div>

  <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:32px;flex-wrap:wrap;gap:16px;">
    <div>
      <div style="display:flex;align-items:center;gap:10px;margin-bottom:8px;flex-wrap:wrap;">
        <h1 style="font-size:28px;font-weight:600;">{tool.Name}</h1>
        {tool.works_in_brazil && <span style="font-size:11px;padding:3px 10px;background:#E6F1FB;color:#185FA5;border-radius:20px;">Funciona no BR</span>}
        {tool.has_free_plan && <span style="font-size:11px;padding:3px 10px;background:#E1F5EE;color:#0F6E56;border-radius:20px;">Plano grátis</span>}
        {tool.ai_native === true && <span style="font-size:11px;padding:3px 10px;background:#D1FAE5;color:#065F46;border-radius:20px;">AI Native 🤖</span>}
      </div>
      <p style="font-size:16px;color:#555;max-width:600px;">{tool.tagline_pt || tool.tagline_en}</p>
    </div>
    <div style="text-align:right;flex-shrink:0;">
      <div style="font-size:20px;font-weight:600;margin-bottom:8px;">
        {tool.has_free_plan && tool.starting_price_usd === 0 ? 'Plano gratuito disponível' : tool.starting_price_usd ? `A partir de ${sym}${tool.starting_price_usd}/mês` : 'Consultar preço'}
      </div>
      <a href={tool.affiliate_url || tool.website} target="_blank"
        style="display:inline-block;padding:12px 24px;background:#1D9E75;color:#fff;border-radius:8px;text-decoration:none;font-size:14px;font-weight:500;">
        Acessar {tool.Name} →
      </a>
    </div>
  </div>

  {tool.description_pt && (
    <div style="margin-bottom:32px;padding:24px;border:1px solid #eee;border-radius:12px;">
      <h2 style="font-size:16px;font-weight:600;margin-bottom:12px;">Sobre {tool.Name}</h2>
      <p style="font-size:14px;color:#444;line-height:1.7;">{tool.description_pt}</p>
    </div>
  )}

  <div style="display:grid;grid-template-columns:1fr 1fr;gap:16px;margin-bottom:32px;">
    <div style="padding:20px;border:1px solid #eee;border-radius:12px;">
      <h2 style="font-size:13px;font-weight:600;margin-bottom:16px;color:#888;text-transform:uppercase;letter-spacing:.05em;">Preços</h2>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:#555;">Preço inicial</span>
          <span style="font-weight:500;">{tool.has_free_plan && tool.starting_price_usd === 0 ? 'Plano gratuito disponível' : `${sym}${tool.starting_price_usd}/mês`}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:#555;">Plano grátis</span>
          <span style="font-weight:500;color:{tool.has_free_plan ? '#0F6E56' : '#888'}">{tool.has_free_plan ? '✓ Sim' : '✗ Não'}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:#555;">Cobrança</span>
          <span style="font-weight:500;">{pricingLabels[tool.pricing_model] || tool.pricing_model || 'Mensal'}</span>
        </div>
      </div>
    </div>

    <div style="padding:20px;border:1px solid #eee;border-radius:12px;">
      <h2 style="font-size:13px;font-weight:600;margin-bottom:16px;color:#888;text-transform:uppercase;letter-spacing:.05em;">Disponibilidade LATAM</h2>
      <div style="display:flex;flex-direction:column;gap:10px;">
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:#555;">Funciona no Brasil</span>
          <span style="font-weight:500;color:{tool.works_in_brazil ? '#0F6E56' : '#888'}">{tool.works_in_brazil ? '✓ Sim' : '✗ Não'}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:#555;">Funciona no México</span>
          <span style="font-weight:500;color:{tool.works_in_mexico ? '#0F6E56' : '#888'}">{tool.works_in_mexico ? '✓ Sim' : '✗ Não'}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:#555;">Aceita BRL</span>
          <span style="font-weight:500;color:{tool.accepts_brl ? '#0F6E56' : '#888'}">{tool.accepts_brl ? '✓ Sim' : '✗ Não'}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:#555;">Suporte PT</span>
          <span style="font-weight:500;color:{tool.has_pt_support ? '#0F6E56' : '#888'}">{tool.has_pt_support ? '✓ Sim' : '✗ Não'}</span>
        </div>
        <div style="display:flex;justify-content:space-between;font-size:13px;">
          <span style="color:#555;">Dados LATAM</span>
          <span style="font-weight:500;color:{tool.has_latam_data ? '#0F6E56' : '#888'}">{tool.has_latam_data ? '✓ Sim' : '✗ Não'}</span>
        </div>
      </div>
    </div>
  </div>

  {tool.latam_note_pt && (
    <div style="margin-bottom:32px;padding:16px 20px;background:#E1F5EE;border-radius:12px;">
      <h2 style="font-size:13px;font-weight:600;color:#0F6E56;margin-bottom:6px;">Nota para o mercado brasileiro</h2>
      <p class="latam-note" style="font-size:13px;color:#085041;line-height:1.6;">{tool.latam_note_pt}</p>
    </div>
  )}

  <div style="text-align:center;padding:32px;border:1px solid #eee;border-radius:12px;background:#f9f9f9;">
    <p style="font-size:15px;color:#555;margin-bottom:16px;">Pronto para usar {tool.Name}?</p>
    <a href={tool.affiliate_url || tool.website} target="_blank"
      style="display:inline-block;padding:12px 32px;background:#1D9E75;color:#fff;border-radius:8px;text-decoration:none;font-size:14px;font-weight:500;">
      Começar com {tool.Name} →
    </a>
  </div>

  {compareEntry && (
    <div style="margin-top:32px;padding:24px;border:1px solid #eee;border-radius:12px;">
      <h2 style="font-size:14px;font-weight:600;color:#888;text-transform:uppercase;letter-spacing:.05em;margin-bottom:16px;">Comparar com outras ferramentas</h2>
      <div style="display:flex;flex-direction:column;gap:10px;">
        {compareEntry.others.map((other) => (
          <a href={`/compare/${compareEntry.cat}/${slug}-vs-${other}`}
            style="display:flex;align-items:center;gap:8px;font-size:14px;color:#1D9E75;text-decoration:none;padding:10px 14px;border:1px solid #e8f5f0;border-radius:8px;background:#f9fdfb;transition:background 0.15s;">
            {tool.Name} vs {other.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ')} →
          </a>
        ))}
      </div>
    </div>
  )}
</Base>
