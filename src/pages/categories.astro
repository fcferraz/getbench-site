---
import Base from '../layouts/Base.astro';
import { getCategories } from '../lib/airtable.js';

const categories = await getCategories();
---

<style>
  .kicker {
    font-family: var(--mono); font-size: 11px; color: var(--accent);
    letter-spacing: .16em; text-transform: uppercase; margin: 24px 0 10px; display: block;
  }
  h1 { font-size: clamp(32px, 4.5vw, 48px); font-weight: 700; letter-spacing: -.03em; margin: 0 0 8px; }
  .lead { font-size: 15px; color: var(--text-dim); margin-bottom: 40px; max-width: 60ch; line-height: 1.6; }
  .cat-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  .cat-card {
    padding: 24px; border: 1px solid var(--line); border-radius: var(--radius);
    background: var(--bg-2); display: block;
    transition: border-color .15s ease, transform .15s ease;
  }
  .cat-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .cat-card h2 { font-size: 15px; font-weight: 600; margin: 0 0 6px; color: var(--text); letter-spacing: -.01em; }
  .cat-card p { font-size: 13px; color: var(--text-dim); margin: 0 0 12px; line-height: 1.5; }
  .cat-card .go { font-family: var(--mono); font-size: 11px; color: var(--text-dim); }
  .cat-card:hover .go { color: var(--accent); }
  .popular {
    margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--line);
    font-size: 13px; color: var(--text-dim); line-height: 1.9;
  }
  .popular b { font-family: var(--mono); font-size: 11px; text-transform: uppercase; letter-spacing: .1em; color: var(--text-dim); font-weight: 500; }
  .popular a { color: var(--accent); }
  .popular a:hover { color: var(--accent-2); }
  @media (max-width: 800px) { .cat-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 480px) { .cat-grid { grid-template-columns: 1fr; } }
</style>

<Base title="Todas as Categorias de AI Tools — Buskai.net">
  <div class="crumb">
    <a href="/">home</a><span class="sep">/</span><span class="cur">categorias</span>
  </div>

  <span class="kicker">▲ DIRETÓRIO · {categories.length} CATEGORIAS</span>
  <h1>Explorar por categoria</h1>
  <p class="lead">Encontre a AI tool certa para o seu caso de uso, curadas para empresas de LATAM.</p>

  <div class="cat-grid">
    {categories.map(cat => (
      <a href={`/category/${cat.Slug}`} class="cat-card">
        <h2>{cat.Name}</h2>
        <p>{cat.title_pt}</p>
        <span class="go">ver ferramentas →</span>
      </a>
    ))}
  </div>

  <div class="popular">
    <b>Buscas populares:</b>
    <a href="/ferramentas-ia-gratuitas">Ferramentas gratuitas</a> ·
    <a href="/ferramentas-ia-brasil">Funciona no Brasil</a> ·
    <a href="/ferramentas-ia-em-portugues">Suporte em PT</a> ·
    <a href="/ferramentas-ia-aceita-reais">Aceita BRL</a>
  </div>
</Base>
