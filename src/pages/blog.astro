---
import Base from '../layouts/Base.astro';
---

<style>
  .breadcrumb { display: flex; gap: 2px; align-items: center; font-size: 12px; color: #bbb; margin-bottom: 28px; flex-wrap: wrap; letter-spacing: 0.01em; }
  .breadcrumb a { color: #999; text-decoration: none; padding: 2px 4px; border-radius: 4px; transition: color 0.15s ease, background 0.15s ease; }
  .breadcrumb a:hover { color: #1D9E75; background: #f0faf6; }
  .breadcrumb span { color: #ddd; font-size: 10px; margin: 0 1px; user-select: none; }
</style>

<Base title="Blog — Buskai.net">
  <div class="breadcrumb">
    <a href="/">Início</a><span>›</span>Blog
  </div>
  <div style="text-align:center;padding:80px 0;">
    <h1 style="font-size:28px;font-weight:600;margin-bottom:12px;">Buskai Blog</h1>
    <p style="font-size:15px;color:#555;max-width:400px;margin:0 auto 32px;line-height:1.6;">
      Guias e comparações de AI tools para LATAM. Em breve.
    </p>
    <a href="/categories" style="display:inline-block;padding:10px 24px;background:#1D9E75;color:#fff;border-radius:8px;text-decoration:none;font-size:14px;">Ver categorias →</a>
  </div>
</Base>
