---
import Base from '../layouts/Base.astro';
---

<style>
  .search-hero { max-width: 760px; margin: 0 auto; padding: 56px 0 40px; text-align: center; }
  .search-hero h1 {
    font-size: clamp(44px, 7vw, 76px); font-weight: 700; line-height: 1.02;
    letter-spacing: -.035em; margin: 0 0 16px;
  }
  .search-hero h1 .accent {
    background: linear-gradient(180deg, var(--accent), var(--accent-2));
    -webkit-background-clip: text; background-clip: text; color: transparent;
  }
  .search-hero p {
    color: var(--text-dim); font-size: 17px; max-width: 520px;
    margin: 0 auto 36px; line-height: 1.5;
  }
  .sbox {
    border: 1px solid var(--line-2); border-radius: 16px;
    background: color-mix(in oklab, var(--bg-2) 90%, transparent);
    box-shadow: 0 0 0 6px var(--accent-glow), 0 30px 60px -30px rgba(40,30,90,.3);
    overflow: hidden; backdrop-filter: blur(10px); text-align: left;
  }
  .sbox .row { display: flex; align-items: center; gap: 12px; padding: 14px 14px 14px 20px; }
  .sbox svg { color: var(--text-dim); flex: none; }
  .sbox input {
    flex: 1; background: transparent; border: 0; outline: 0;
    color: var(--text); font-size: 17px; font-family: var(--sans); min-width: 0;
  }
  .sbox input::placeholder { color: var(--text-dimmer); }
  .sbox .go {
    background: var(--accent); color: var(--on-accent); border: 0;
    padding: 10px 20px; border-radius: 10px; font-weight: 600; font-size: 14px;
    cursor: pointer; white-space: nowrap;
  }
  .sbox .go:hover { background: var(--accent-2); }
  .sbox .chips { padding: 0 14px 14px; display: flex; gap: 8px; flex-wrap: wrap; }
  .sbox .chips button {
    background: transparent; border: 1px solid var(--line);
    color: var(--text-dim); padding: 5px 12px; border-radius: 999px;
    font-size: 12px; cursor: pointer; font-family: var(--mono);
  }
  .sbox .chips button:hover { color: var(--text); border-color: var(--line-2); }
  .results-wrap { max-width: 760px; margin: 0 auto; }
  #loading { display: none; text-align: center; padding: 60px 0; }
  #loading .inner {
    display: inline-flex; align-items: center; gap: 12px;
    color: var(--text-dim); font-family: var(--mono); font-size: 13px;
  }
  #loading .spin {
    width: 16px; height: 16px; border: 2px solid var(--accent-glow);
    border-top-color: var(--accent); border-radius: 50%;
    animation: spin .8s linear infinite;
  }
  @keyframes spin { to { transform: rotate(360deg); } }
</style>

<Base title="Buscar AI tools para LATAM — Buskai.net">
  <div class="search-hero">
    <h1>
      Ache a AI tool certa.<br/>
      <span class="accent">Em 10 segundos.</span>
    </h1>
    <p>
      Descreva o que você precisa — devolvemos um shortlist com preço em R$, suporte PT/ES e postura LGPD.
    </p>
    <div class="sbox" id="search-box">
      <div class="row">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.35-4.35"/></svg>
        <input id="query" type="text" placeholder="bot de WhatsApp para clínica em São Paulo..."/>
        <button id="search-btn" onclick="runSearch()" class="go">Buscar →</button>
      </div>
      <div class="chips">
        <button onclick="setQuery('SDR em PT-BR')">SDR em PT-BR</button>
        <button onclick="setQuery('Copiloto de CRM')">Copiloto de CRM</button>
        <button onclick="setQuery('ferramentas de marketing gratuitas')">Marketing grátis</button>
        <button onclick="setQuery('recrutamento RH Brasil')">Recrutamento RH</button>
      </div>
    </div>
  </div>
  <div class="results-wrap">
    <div id="loading">
      <div class="inner">
        <div class="spin"></div>
        Analisando tools para sua busca...
      </div>
    </div>
    <div id="results" style="display:none;"></div>
  </div>

  <script is:inline>
    function setQuery(q) {
      document.getElementById('query').value = q;
    }
    document.getElementById('query').addEventListener('keydown', function(e) {
      if (e.key === 'Enter') runSearch();
    });
    // Autorun when arriving with ?q= (e.g. from the ⌘K modal's full-page link)
    (function() {
      var q = new URLSearchParams(window.location.search).get('q');
      if (q) { document.getElementById('query').value = q; runSearch(); }
    })();
    async function runSearch() {
      const query = document.getElementById('query').value.trim();
      if (!query) return;
      document.getElementById('results').style.display = 'none';
      document.getElementById('loading').style.display = 'block';
      document.getElementById('search-btn').disabled = true;
      document.getElementById('search-btn').textContent = 'Buscando...';
      try {
        const res = await fetch('/api/search', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ query })
        });
        const data = await res.json();
        document.getElementById('loading').style.display = 'none';
        document.getElementById('results').style.display = 'block';
        renderResults(data, query);
      } catch(e) {
        document.getElementById('loading').style.display = 'none';
        document.getElementById('results').innerHTML = '<p style="color:var(--red);text-align:center;">Erro ao buscar. Tente novamente.</p>';
        document.getElementById('results').style.display = 'block';
      }
      document.getElementById('search-btn').disabled = false;
      document.getElementById('search-btn').textContent = 'Buscar →';
    }
    function elWithStyle(tag, style, text) {
      var el = document.createElement(tag);
      if (style) el.setAttribute('style', style);
      if (text != null) el.textContent = String(text);
      return el;
    }
    function safeSlug(slug) {
      return String(slug || '').replace(/[^a-zA-Z0-9_-]/g, '');
    }
    function safeHttpsUrl(url) {
      // only allow absolute https URLs for outbound links
      return /^https:\/\//i.test(url || '') ? url : null;
    }
    function renderResults(data, query) {
      const c = document.getElementById('results');
      c.innerHTML = '';
      if (!data || !Array.isArray(data.tools)) {
        c.appendChild(elWithStyle('p', 'color:var(--red);text-align:center;', 'Erro ao buscar. Tente novamente.'));
        return;
      }

      c.appendChild(elWithStyle('div',
        'margin-bottom:16px;font-family:var(--mono);font-size:11px;color:var(--text-dimmer);',
        data.tools.length + ' tools para "' + query + '"'));

      var reasoningBox = elWithStyle('div', 'margin-bottom:20px;padding:16px 20px;border:1px solid var(--line-2);border-radius:12px;background:color-mix(in oklab, var(--accent-glow) 30%, transparent);');
      reasoningBox.appendChild(elWithStyle('p', 'color:var(--text-dim);font-size:14px;line-height:1.6;margin:0;', data.reasoning || ''));
      c.appendChild(reasoningBox);

      var list = elWithStyle('div', 'display:flex;flex-direction:column;gap:12px;');
      data.tools.forEach(function(tool, i) {
        var card = elWithStyle('div', 'border:1px solid var(--line);border-radius:14px;padding:20px 24px;background:var(--bg-2);display:flex;justify-content:space-between;align-items:flex-start;');

        var left = elWithStyle('div', 'flex:1;');
        var titleRow = elWithStyle('div', 'display:flex;align-items:center;gap:10px;margin-bottom:8px;');
        titleRow.appendChild(elWithStyle('span', 'font-family:var(--mono);font-size:11px;color:var(--accent);', '#' + (i + 1)));

        var nameLink = elWithStyle('a', 'font-size:17px;font-weight:600;color:var(--text);text-decoration:none;', tool.name);
        nameLink.setAttribute('href', '/tools/' + safeSlug(tool.slug));
        titleRow.appendChild(nameLink);

        if (tool.works_in_brazil) {
          titleRow.appendChild(elWithStyle('span', 'font-size:11px;padding:2px 8px;background:rgba(74,134,255,.12);color:#4a86ff;border-radius:20px;', 'Funciona no BR'));
        }
        if (tool.has_free_plan) {
          titleRow.appendChild(elWithStyle('span', 'font-size:11px;padding:2px 8px;background:var(--accent-glow);color:var(--accent);border-radius:20px;', 'Plano grátis'));
        }
        left.appendChild(titleRow);
        left.appendChild(elWithStyle('p', 'color:var(--text-dim);font-size:13px;margin:0 0 6px;', tool.tagline));
        left.appendChild(elWithStyle('p', 'color:var(--text-dimmer);font-size:12px;margin:0;font-style:italic;', tool.reason));
        card.appendChild(left);

        var right = elWithStyle('div', 'text-align:right;margin-left:20px;flex-shrink:0;');
        right.appendChild(elWithStyle('div', 'font-size:15px;font-weight:600;margin-bottom:10px;color:var(--text);font-family:var(--mono);', tool.price));

        var visitUrl = safeHttpsUrl(tool.affiliate_url || tool.website);
        if (visitUrl) {
          var visit = elWithStyle('a', 'display:inline-block;padding:8px 18px;background:var(--accent);color:var(--on-accent);border-radius:8px;text-decoration:none;font-size:13px;font-weight:600;', 'Visitar →');
          visit.setAttribute('href', visitUrl);
          visit.setAttribute('target', '_blank');
          visit.setAttribute('rel', 'noopener noreferrer');
          right.appendChild(visit);
        }
        card.appendChild(right);

        list.appendChild(card);
      });
      c.appendChild(list);
    }
  </script>
</Base>
