---
import Base from '../../layouts/Base.astro';
---

<style>
  .breadcrumb { display: flex; gap: 2px; align-items: center; font-size: 12px; color: #bbb; margin-bottom: 28px; flex-wrap: wrap; letter-spacing: 0.01em; }
  .breadcrumb a { color: #999; text-decoration: none; padding: 2px 4px; border-radius: 4px; transition: color 0.15s ease, background 0.15s ease; }
  .breadcrumb a:hover { color: #1D9E75; background: #f0faf6; }
  .breadcrumb span { color: #ddd; font-size: 10px; margin: 0 1px; user-select: none; }
</style>

<Base title="Envie sua ferramenta de IA — Buskai.net">
  <div class="breadcrumb">
    <a href="/">Início</a><span>›</span>Enviar ferramenta
  </div>

  <div style="max-width:700px;">
    <h1 style="font-size:28px;font-weight:600;margin-bottom:12px;line-height:1.3;">Envie sua ferramenta de IA</h1>
    <p style="font-size:15px;color:#555;line-height:1.6;margin-bottom:32px;">
      Curadorizamos AI tools para o mercado LATAM. Preencha o formulário e avaliaremos em até 48h.
    </p>

    <iframe
      src="https://airtable.com/embed/appFwfYV1xtqMcEMg/pagsfUOIXdnZwYS6f/form"
      width="100%"
      height="800"
      style="border:none;border-radius:12px;">
    </iframe>
  </div>
</Base>
