---
import Base from '../../layouts/Base.astro';
---

<style>
  .breadcrumb { display: flex; gap: 2px; align-items: center; font-size: 12px; color: #bbb; margin-bottom: 28px; flex-wrap: wrap; letter-spacing: 0.01em; }
  .breadcrumb a { color: #999; text-decoration: none; padding: 2px 4px; border-radius: 4px; transition: color 0.15s ease, background 0.15s ease; }
  .breadcrumb a:hover { color: #1D9E75; background: #f0faf6; }
  .breadcrumb span { color: #ddd; font-size: 10px; margin: 0 1px; user-select: none; }

  #form-modal {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 999;
    background: rgba(0,0,0,.65);
    backdrop-filter: blur(4px);
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  #form-modal.open { display: flex; }
  .modal-card {
    background: #fff;
    border-radius: 16px;
    width: 100%;
    max-width: 680px;
    overflow: hidden;
    box-shadow: 0 24px 64px rgba(0,0,0,.25);
  }
  .modal-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 16px 20px;
    border-bottom: 1px solid #eee;
  }
  .modal-header span { font-size: 14px; font-weight: 600; color: #1a1a1a; }
  .modal-close {
    background: none;
    border: none;
    cursor: pointer;
    color: #888;
    font-size: 20px;
    line-height: 1;
    padding: 4px;
    border-radius: 6px;
    transition: background .15s;
  }
  .modal-close:hover { background: #f5f5f5; color: #1a1a1a; }
</style>

<Base title="Envie sua ferramenta de IA — Buskai.net">
  <div class="breadcrumb">
    <a href="/">Início</a><span>›</span>Enviar ferramenta
  </div>

  <div style="max-width:600px;">
    <h1 style="font-size:28px;font-weight:600;margin-bottom:12px;line-height:1.3;">Envie sua ferramenta de IA</h1>
    <p style="font-size:15px;color:#555;line-height:1.7;margin-bottom:32px;">
      Curadorizamos AI tools para o mercado LATAM. Preencha o formulário e avaliaremos em até 48h.
    </p>

    <button
      onclick="document.getElementById('form-modal').classList.add('open')"
      style="padding:14px 32px;background:#1D9E75;color:#fff;border:none;border-radius:8px;font-size:15px;font-weight:600;cursor:pointer;">
      Preencher formulário →
    </button>
  </div>
</Base>

<div id="form-modal" onclick="handleModalClick(event)">
  <div class="modal-card">
    <div class="modal-header">
      <span>Enviar ferramenta</span>
      <button class="modal-close" onclick="closeModal()" aria-label="Fechar">✕</button>
    </div>
    <iframe
      src="https://airtable.com/embed/appFwfYV1xtqMcEMg/pagsfUOIXdnZwYS6f/form"
      frameborder="0"
      width="100%"
      height="600"
      style="background:transparent;border:none;display:block;">
    </iframe>
  </div>
</div>

<script is:inline>
  function closeModal() {
    document.getElementById('form-modal').classList.remove('open');
  }
  function handleModalClick(e) {
    if (e.target === document.getElementById('form-modal')) closeModal();
  }
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') closeModal();
  });
</script>
