---
import Base from '../../layouts/Base.astro';
---

<style>
  .breadcrumb { display: flex; gap: 2px; align-items: center; font-size: 12px; color: #bbb; margin-bottom: 28px; flex-wrap: wrap; letter-spacing: 0.01em; }
  .breadcrumb a { color: #999; text-decoration: none; padding: 2px 4px; border-radius: 4px; transition: color 0.15s ease, background 0.15s ease; }
  .breadcrumb a:hover { color: #1D9E75; background: #f0faf6; }
  .breadcrumb span { color: #ddd; font-size: 10px; margin: 0 1px; user-select: none; }
</style>

<Base title="Enviar Ferramenta — Buskai.net">
  <div class="breadcrumb">
    <a href="/">Home</a><span>›</span>Enviar uma ferramenta
  </div>
  <div style="max-width:560px;margin:0 auto;padding:40px 0;">
    <h1 style="font-size:28px;font-weight:600;margin-bottom:12px;">Envie sua ferramenta de IA</h1>
    <p style="font-size:15px;color:#555;margin-bottom:32px;line-height:1.6;">
      Quer listar sua ferramenta no Buskai? Curadorizamos AI tools para o mercado LATAM. Envie os detalhes e avaliaremos.
    </p>
    <div style="padding:24px;border:1px solid #eee;border-radius:12px;background:#f9f9f9;text-align:center;">
      <p style="font-size:14px;color:#555;margin-bottom:16px;">Envie um e-mail com o nome da ferramenta, site e uma breve descrição.</p>
      <a href="mailto:hello@buskai.net" style="display:inline-block;padding:10px 24px;background:#1D9E75;color:#fff;border-radius:8px;text-decoration:none;font-size:14px;">hello@buskai.net</a>
    </div>
  </div>
</Base>
