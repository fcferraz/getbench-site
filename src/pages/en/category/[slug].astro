---
import Base from '../../../layouts/Base.astro';
import { getCategories, getToolsByCategory } from '../../../lib/airtable.js';

const { slug } = Astro.params;
const categories = await getCategories();
const category = categories.find(c => c.Slug === slug) || {};
const tools = await getToolsByCategory(category.Name || '');
---

<style>
  .breadcrumb { display: flex; gap: 2px; align-items: center; font-size: 12px; color: #bbb; margin-bottom: 28px; flex-wrap: wrap; letter-spacing: 0.01em; }
  .breadcrumb a { color: #999; text-decoration: none; padding: 2px 4px; border-radius: 4px; transition: color 0.15s ease, background 0.15s ease; }
  .breadcrumb a:hover { color: #1D9E75; background: #f0faf6; }
  .breadcrumb span { color: #ddd; font-size: 10px; margin: 0 1px; user-select: none; }
  .latam-note {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<Base title={`${category.title_pt} — Buskai.net`}>
  <div class="breadcrumb">
    <a href="/">Início</a><span>›</span>
    <a href="/en/categories">Categorias</a><span>›</span>
    {category.Name}
  </div>

  <h1 style="font-size:28px;font-weight:600;margin-bottom:12px;">{category.title_pt}</h1>
  <p style="font-size:15px;color:#555;margin-bottom:12px;max-width:600px;line-height:1.6;">
    {category.description_en || 'Compare as melhores AI tools desta categoria, curadas para LATAM.'}
  </p>
  <p style="font-size:13px;color:#888;margin-bottom:20px;" id="tools-count">{tools.length} tools encontradas</p>

  <div style="display:flex;gap:8px;margin-bottom:32px;flex-wrap:wrap;" id="filters">
    <button onclick="toggleFilter(this, 'all')" style="padding:6px 14px;border:1px solid #1D9E75;border-radius:20px;font-size:12px;cursor:pointer;background:#1D9E75;color:#fff;">Todas</button>
    <button onclick="toggleFilter(this, 'free')" style="padding:6px 14px;border:1px solid #ddd;border-radius:20px;font-size:12px;cursor:pointer;background:#fff;color:#555;">Plano grátis</button>
    <button onclick="toggleFilter(this, 'br')" style="padding:6px 14px;border:1px solid #ddd;border-radius:20px;font-size:12px;cursor:pointer;background:#fff;color:#555;">Funciona no BR</button>
    <button onclick="toggleFilter(this, 'brl')" style="padding:6px 14px;border:1px solid #ddd;border-radius:20px;font-size:12px;cursor:pointer;background:#fff;color:#555;">Aceita BRL</button>
    <button onclick="toggleFilter(this, 'pt')" style="padding:6px 14px;border:1px solid #ddd;border-radius:20px;font-size:12px;cursor:pointer;background:#fff;color:#555;">Suporte PT</button>
    <button onclick="toggleFilter(this, 'ainative')" style="padding:6px 14px;border:1px solid #ddd;border-radius:20px;font-size:12px;cursor:pointer;background:#fff;color:#555;">AI Native 🤖</button>
  </div>

  {tools.length === 0 ? (
    <div style="padding:40px;background:#f9f9f9;border-radius:12px;text-align:center;color:#888;">
      Tools em breve.
    </div>
  ) : (
    <div style="display:flex;flex-direction:column;gap:16px;" id="tools-list">
      {tools.map(tool => (
        <div class="tool-card" data-free={tool.has_free_plan ? '1' : '0'} data-br={tool.works_in_brazil ? '1' : '0'} data-brl={tool.accepts_brl ? '1' : '0'} data-pt={tool.has_pt_support ? '1' : '0'} data-ainative={tool.ai_native === true ? '1' : '0'} style="padding:24px;border:1px solid #eee;border-radius:12px;display:flex;justify-content:space-between;align-items:flex-start;">
          <div style="flex:1;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
              <a href={`/en/tools/${tool.slug}`} style="font-size:16px;font-weight:600;color:#1a1a1a;text-decoration:none;">{tool.Name}</a>
              {tool.works_in_brazil && <span style="font-size:11px;padding:2px 8px;background:#E6F1FB;color:#185FA5;border-radius:20px;">Funciona no BR</span>}
              {tool.has_free_plan && <span style="font-size:11px;padding:2px 8px;background:#E1F5EE;color:#0F6E56;border-radius:20px;">Plano grátis</span>}
              {tool.ai_native === true && <span style="font-size:11px;padding:2px 8px;background:#D1FAE5;color:#065F46;border-radius:20px;">AI Native 🤖</span>}
            </div>
            <p style="font-size:13px;color:#555;margin-bottom:10px;">{tool.tagline_pt || tool.tagline_en}</p>
            {tool.latam_note_pt && (
              <p class="latam-note" style="font-size:11px;color:#0F6E56;background:#E1F5EE;padding:4px 10px;border-radius:6px;display:inline-block;">{tool.latam_note_pt}</p>
            )}
          </div>
          <div style="text-align:right;margin-left:24px;flex-shrink:0;">
            <div style="font-size:14px;font-weight:500;margin-bottom:8px;">
              {tool.has_free_plan && tool.starting_price_usd === 0 ? 'Plano gratuito disponível' : tool.starting_price_usd ? `A partir de $${tool.starting_price_usd}/mês` : 'Consultar preço'}
            </div>
            <div style="display:flex;gap:8px;justify-content:flex-end;">
              <a href={`/en/tools/${tool.slug}`} style="display:inline-block;padding:6px 12px;border:1px solid #ddd;border-radius:6px;text-decoration:none;font-size:12px;color:#333;">Detalhes</a>
              <a href={tool.affiliate_url || tool.website} target="_blank" style="display:inline-block;padding:6px 16px;background:#1D9E75;color:#fff;border-radius:6px;text-decoration:none;font-size:12px;">Visitar →</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}

  <script is:inline>
    function toggleFilter(btn, filter) {
      document.querySelectorAll('#filters button').forEach(b => {
        b.style.background = '#fff';
        b.style.color = '#555';
        b.style.borderColor = '#ddd';
      });
      btn.style.background = '#1D9E75';
      btn.style.color = '#fff';
      btn.style.borderColor = '#1D9E75';
      const cards = document.querySelectorAll('.tool-card');
      let visible = 0;
      cards.forEach(card => {
        let show = true;
        if (filter === 'free') show = card.dataset.free === '1';
        if (filter === 'br') show = card.dataset.br === '1';
        if (filter === 'brl') show = card.dataset.brl === '1';
        if (filter === 'pt') show = card.dataset.pt === '1';
        if (filter === 'ainative') show = card.dataset.ainative === '1';
        card.style.display = show ? 'flex' : 'none';
        if (show) visible++;
      });
      document.getElementById('tools-count').textContent = visible + ' tools encontradas';
    }
  </script>
</Base>
