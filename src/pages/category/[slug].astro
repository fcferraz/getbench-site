---
import Base from '../../layouts/Base.astro';
import { getCategories, getToolsByCategory } from '../../lib/airtable.js';

const { slug } = Astro.params;
const categories = await getCategories();
const category = categories.find(c => c.Slug === slug) || {};
const tools = await getToolsByCategory(category.Name || '');
const currencySymbol = (c) => c === 'BRL' ? 'R$' : c === 'EUR' ? '€' : '$';
---

<style>
  .breadcrumb { display: flex; gap: 2px; align-items: center; font-size: 12px; color: #bbb; margin-bottom: 28px; flex-wrap: wrap; letter-spacing: 0.01em; }
  .breadcrumb a { color: #999; text-decoration: none; padding: 2px 4px; border-radius: 4px; transition: color 0.15s ease, background 0.15s ease; }
  .breadcrumb a:hover { color: #1D9E75; background: #f0faf6; }
  .breadcrumb span { color: #ddd; font-size: 10px; margin: 0 1px; user-select: none; }
  .latam-note {
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
</style>

<Base title={`${category.title_pt} — Buskai.net`}>
  <div class="breadcrumb">
    <a href="/">Início</a><span>›</span>
    <a href="/categories">Categorias</a><span>›</span>
    {category.Name}
  </div>

  <h1 style="font-size:28px;font-weight:600;margin-bottom:12px;">{category.title_pt}</h1>
  <p style="font-size:15px;color:#555;margin-bottom:12px;max-width:600px;line-height:1.6;">
    {category.description_en || 'Compare as melhores AI tools desta categoria, curadas para LATAM.'}
  </p>
  <p style="font-size:13px;color:#888;margin-bottom:20px;" id="tools-count">{tools.length} ferramentas encontradas</p>

  <div id="filter-bar" style="display:flex;gap:12px;align-items:center;margin-bottom:24px;flex-wrap:wrap;">
    <select id="filter-price" onchange="applyFilters()" style="padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:13px;color:#333;background:#fff;cursor:pointer;">
      <option value="all">💰 Preço — Todos</option>
      <option value="free">Gratuito</option>
      <option value="freemium">Freemium</option>
      <option value="paid">Pago</option>
    </select>
    <select id="filter-location" onchange="applyFilters()" style="padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:13px;color:#333;background:#fff;cursor:pointer;">
      <option value="all">🌎 Localização — Todos</option>
      <option value="br">Funciona no BR</option>
      <option value="brl">Aceita BRL</option>
      <option value="pt">Suporte em PT</option>
    </select>
    <select id="filter-type" onchange="applyFilters()" style="padding:8px 12px;border:1px solid #ddd;border-radius:8px;font-size:13px;color:#333;background:#fff;cursor:pointer;">
      <option value="all">🤖 Tipo — Todos</option>
      <option value="ainative">AI Native</option>
    </select>
    <button id="clear-filters" onclick="clearFilters()" style="display:none;padding:8px 14px;border:1px solid #e55;border-radius:8px;font-size:13px;color:#e55;background:#fff;cursor:pointer;">✕ Limpar filtros</button>
  </div>

  <style>
    @media (max-width: 640px) {
      #filter-bar { flex-direction: column; align-items: stretch; }
      #filter-bar select, #filter-bar button { width: 100%; }
    }
  </style>

  {tools.length === 0 ? (
    <div style="padding:40px;background:#f9f9f9;border-radius:12px;text-align:center;color:#888;">
      Tools em breve.
    </div>
  ) : (
    <div style="display:flex;flex-direction:column;gap:16px;" id="tools-list">
      {tools.map(tool => (
        <div class="tool-card" data-free={tool.has_free_plan ? '1' : '0'} data-br={tool.works_in_brazil ? '1' : '0'} data-brl={tool.accepts_brl ? '1' : '0'} data-pt={tool.has_pt_support ? '1' : '0'} data-ainative={tool.ai_native === true ? '1' : '0'} data-pricing={tool.starting_price_usd === 0 ? 'free' : tool.has_free_plan ? 'freemium' : tool.starting_price_usd ? 'paid' : 'unknown'} style="padding:24px;border:1px solid #eee;border-radius:12px;display:flex;justify-content:space-between;align-items:flex-start;">
          <div style="flex:1;">
            <div style="display:flex;align-items:center;gap:8px;margin-bottom:8px;flex-wrap:wrap;">
              <a href={`/tools/${tool.slug}`} style="font-size:16px;font-weight:600;color:#1a1a1a;text-decoration:none;">{tool.Name}</a>
              {tool.starting_price_usd === 0 ? <span style="font-size:11px;padding:2px 8px;background:#E1F5EE;color:#0F6E56;border-radius:20px;">Gratuito</span> : tool.has_free_plan ? <span style="font-size:11px;padding:2px 8px;background:#FEF3C7;color:#92400E;border-radius:20px;">Freemium</span> : tool.starting_price_usd ? <span style="font-size:11px;padding:2px 8px;background:#F3F4F6;color:#374151;border-radius:20px;">Pago</span> : null}
              {tool.ai_native === true && <span style="font-size:11px;padding:2px 8px;background:#D1FAE5;color:#065F46;border-radius:20px;">AI Native 🤖</span>}
            </div>
            <p style="font-size:13px;color:#555;margin-bottom:10px;">{tool.tagline_pt || tool.tagline_en}</p>
            {tool.latam_note_pt && (
              <p class="latam-note" style="font-size:11px;color:#0F6E56;background:#E1F5EE;padding:4px 10px;border-radius:6px;display:inline-block;">{tool.latam_note_pt}</p>
            )}
          </div>
          <div style="text-align:right;margin-left:24px;flex-shrink:0;">
            <div style="font-size:14px;font-weight:500;margin-bottom:8px;">
              {tool.has_free_plan && tool.starting_price_usd === 0 ? 'Plano gratuito disponível' : tool.starting_price_usd ? `A partir de ${currencySymbol(tool.currency)}${tool.starting_price_usd}/mês` : 'Consultar preço'}
            </div>
            <div style="display:flex;gap:8px;justify-content:flex-end;">
              <a href={`/tools/${tool.slug}`} style="display:inline-block;padding:6px 12px;border:1px solid #ddd;border-radius:6px;text-decoration:none;font-size:12px;color:#333;">Detalhes</a>
              <a href={tool.affiliate_url || tool.website} target="_blank" style="display:inline-block;padding:6px 16px;background:#1D9E75;color:#fff;border-radius:6px;text-decoration:none;font-size:12px;">Visitar →</a>
            </div>
          </div>
        </div>
      ))}
    </div>
  )}

  <script is:inline>
    function applyFilters() {
      const price    = document.getElementById('filter-price').value;
      const location = document.getElementById('filter-location').value;
      const type     = document.getElementById('filter-type').value;

      const isFiltered = price !== 'all' || location !== 'all' || type !== 'all';
      document.getElementById('clear-filters').style.display = isFiltered ? 'inline-block' : 'none';

      const cards = document.querySelectorAll('.tool-card');
      let visible = 0;
      cards.forEach(card => {
        let show = true;
        if (price === 'free')      show = show && card.dataset.pricing === 'free';
        if (price === 'freemium')  show = show && card.dataset.pricing === 'freemium';
        if (price === 'paid')      show = show && card.dataset.pricing === 'paid';
        if (location === 'br')     show = show && card.dataset.br === '1';
        if (location === 'brl')    show = show && card.dataset.brl === '1';
        if (location === 'pt')     show = show && card.dataset.pt === '1';
        if (type === 'ainative')   show = show && card.dataset.ainative === '1';
        card.style.display = show ? 'flex' : 'none';
        if (show) visible++;
      });
      document.getElementById('tools-count').textContent = visible + ' ferramentas encontradas';
    }

    function clearFilters() {
      document.getElementById('filter-price').value    = 'all';
      document.getElementById('filter-location').value = 'all';
      document.getElementById('filter-type').value     = 'all';
      document.getElementById('clear-filters').style.display = 'none';
      document.querySelectorAll('.tool-card').forEach(c => c.style.display = 'flex');
      document.getElementById('tools-count').textContent =
        document.querySelectorAll('.tool-card').length + ' ferramentas encontradas';
    }
  </script>
</Base>
