  <div class="breadcrumb">
    <a href="/">Início</a><span>›</span>
    <a href="/blog">Blog</a><span>›</span>
    IA para vendas B2B brasileiras
  </div>

  <div class="page-layout">
    <aside class="sidebar">
      <div class="sidebar-title">Neste artigo</div>
      <nav class="sidebar-nav" aria-label="Sumário">
        <ol>
          <li><a href="#hubspot-sales">1. HubSpot Sales</a></li>
          <li><a href="#pipedrive-sales">2. Pipedrive</a></li>
