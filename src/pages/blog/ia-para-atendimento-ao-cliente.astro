    },
    "publisher": {
      "@type": "Organization",
      "name": "Buskai",
      "url": "https://buskai.net"
    }
  })} />

  <style>
    .breadcrumb { display: flex; gap: 2px; align-items: center; font-size: 12px; color: #bbb; margin-bottom: 28px; flex-wrap: wrap; letter-spacing: 0.01em; }
    .breadcrumb a { color: #999; text-decoration: none; padding: 2px 4px; border-radius: 4px; transition: color 0.15s ease, background 0.15s ease; }
    .breadcrumb a:hover { color: #1D9E75; background: #f0faf6; }
    .breadcrumb span { color: #ddd; font-size: 10px; margin: 0 1px; user-select: none; }
    .page-layout { display: grid; grid-template-columns: 200px 1fr 240px; gap: 32px; align-items: start; }
    .sidebar { position: sticky; top: 80px; }
    .sidebar-title { font-size: 11px; font-weight: 700; color: #aaa; text-transform: uppercase; letter-spacing: .08em; margin-bottom: 12px; }
    .sidebar-nav ol { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 2px; }
    .sidebar-nav a { display: block; font-size: 13px; color: #999; text-decoration: none; padding: 5px 0 5px 12px; border-left: 2px solid #eee; line-height: 1.45; transition: color 0.15s, border-color 0.15s; }
    .sidebar-nav a:hover { color: #1D9E75; border-left-color: #c8ead9; }
    .sidebar-nav a.active { color: #1D9E75; border-left-color: #1D9E75; font-weight: 600; }
    .article h1 { font-size: 30px; font-weight: 700; line-height: 1.25; margin-bottom: 12px; color: #1a1a1a; }
    .article .meta { font-size: 13px; color: #aaa; margin-bottom: 36px; }
    .article p { font-size: 15px; color: #333; line-height: 1.75; margin-bottom: 20px; }
    .tool-block { border: 1px solid #eee; border-radius: 14px; padding: 28px; margin-bottom: 28px; scroll-margin-top: 24px; }
    .tool-block h2 { font-size: 19px; font-weight: 700; margin-bottom: 10px; color: #1a1a1a; }
    .tool-block p { margin-bottom: 10px; }
    .tool-block p:last-child { margin-bottom: 0; }
