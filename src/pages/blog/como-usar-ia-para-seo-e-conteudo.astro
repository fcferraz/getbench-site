  title="Como usar IA para criar e otimizar conteúdo para SEO"
  description="Aprenda a usar ferramentas de IA para criar conteúdo otimizado para SEO e ranquear no Google — com dicas práticas e ferramentas que funcionam no Brasil."
  faqs={frontmatter.faqs}
>
  <script type="application/ld+json" set:html={JSON.stringify({
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": frontmatter.title,
    "description": frontmatter.description,
    "datePublished": frontmatter.date,
    "dateModified": frontmatter.date,
    "author": {
      "@type": "Organization",
      "name": "Buskai",
      "url": "https://buskai.net"
    },
    "publisher": {
      "@type": "Organization",
      "name": "Buskai",
