---

<style>
  .breadcrumb { display:flex; gap:2px; align-items:center; font-size:12px; color:#bbb; margin-bottom:28px; flex-wrap:wrap; letter-spacing:.01em; }
  .breadcrumb a { color:#999; text-decoration:none; padding:2px 4px; border-radius:4px; transition:color .15s,background .15s; }
  .breadcrumb a:hover { color:#1D9E75; background:#f0faf6; }
  .breadcrumb span { color:#ddd; font-size:10px; margin:0 1px; user-select:none; }

  /* ── Hero ── */
  .hero {
    display: grid;
    grid-template-columns: 3fr 2fr;
    gap: 40px;
    align-items: center;
    margin-bottom: 56px;
  }
  .hero-title {
    font-size: 30px;
    font-weight: 700;
    line-height: 1.2;
    color: #1a1a1a;
    margin-bottom: 12px;
  }
  .hero-subtitle {
    font-size: 15px;
    color: #555;
    line-height: 1.6;
    margin-bottom: 24px;
    max-width: 480px;
  }
  .search-wrap {
    display: flex;
    gap: 8px;
    max-width: 500px;
  }
  .search-input {
    flex: 1;
    padding: 10px 16px;
    border: 1px solid #ddd;
    border-radius: 8px;
    font-size: 14px;
    color: #1a1a1a;
    outline: none;
    transition: border-color .15s;
  }
  .search-input:focus { border-color: #1D9E75; }
  .search-btn {
    padding: 10px 20px;
    background: #1D9E75;
    color: #fff;
    border: none;
    border-radius: 8px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: background .15s;
  }
  .search-btn:hover { background: #178f68; }

  /* ── Featured card ── */
  .featured-card {
    border: 2px solid #1D9E75;
    border-radius: 14px;
    padding: 28px;
    background: #f0faf6;
    text-decoration: none;
    color: inherit;
    display: block;
    transition: box-shadow .15s;
  }
  .featured-card:hover { box-shadow: 0 4px 20px rgba(29,158,117,.15); }
  .featured-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 600;
    padding: 3px 10px;
    background: #1D9E75;
    color: #fff;
    border-radius: 20px;
    margin-bottom: 14px;
    letter-spacing: .03em;
  }
  .featured-card h2 { font-size: 18px; font-weight: 700; color: #1a1a1a; line-height: 1.35; margin-bottom: 10px; }
  .featured-card p { font-size: 14px; color: #444; line-height: 1.65; margin-bottom: 16px; }
  .featured-meta { font-size: 12px; color: #888; margin-bottom: 18px; }
  .featured-cta {
    display: inline-block;
    padding: 10px 22px;
    background: #1D9E75;
    color: #fff;
    border-radius: 8px;
    font-size: 13px;
    font-weight: 600;
    text-decoration: none;
    transition: background .15s;
  }
  .featured-cta:hover { background: #178f68; }

  /* ── Category sections ── */
  .category-section { margin-bottom: 48px; }
  .section-header {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    border-bottom: 2px solid #1D9E75;
    padding-bottom: 8px;
    margin-bottom: 24px;
  }
  .section-header h2 { font-size: 20px; font-weight: 600; color: #1a1a1a; }
  .section-header a { font-size: 13px; color: #1D9E75; text-decoration: none; font-weight: 500; }
  .section-header a:hover { text-decoration: underline; }

  .cards-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }

  /* ── Article card ── */
  .article-card {
    border: 1px solid #eee;
    border-radius: 12px;
    padding: 20px;
    text-decoration: none;
    color: inherit;
    display: flex;
    flex-direction: column;
    gap: 10px;
    transition: border-color .15s, box-shadow .15s;
  }
  .article-card:hover {
    border-color: #c8ead9;
    box-shadow: 0 2px 12px rgba(29,158,117,.08);
  }
  .card-tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 500;
    padding: 3px 10px;
    background: #f0faf6;
    color: #1D9E75;
    border-radius: 20px;
    align-self: flex-start;
  }
  .article-card h3 { font-size: 15px; font-weight: 600; color: #1a1a1a; line-height: 1.4; }
  .card-desc { font-size: 13px; color: #666; line-height: 1.6; flex: 1; }
  .card-footer { display: flex; justify-content: space-between; align-items: center; margin-top: auto; }
  .card-date { font-size: 12px; color: #aaa; }
  .card-link { font-size: 13px; color: #1D9E75; font-weight: 500; }

  /* ── No-results message ── */
  .no-results { display:none; padding:40px; text-align:center; color:#888; font-size:15px; }

  /* ── Responsive ── */
  @media (max-width: 900px) {
    .hero { grid-template-columns: 1fr; }
    .hero-right { order: -1; }
    .cards-grid { grid-template-columns: repeat(2, 1fr); }
  }
  @media (max-width: 560px) {
    .cards-grid { grid-template-columns: 1fr; }
    .search-wrap { max-width: 100%; }
    .hero-title { font-size: 24px; }
  }
</style>

<Base
  title="Blog — IA para empresas brasileiras | Buskai"
  description="Guias práticos, comparativos e estratégias para usar IA no seu negócio no Brasil."
>
  <div class="breadcrumb">
    <a href="/">Início</a><span>›</span>Blog
  </div>

  <!-- ── Hero ── -->
  <div class="hero">
    <div class="hero-left">
      <h1 class="hero-title">Blog — IA para empresas brasileiras</h1>
      <p class="hero-subtitle">Guias práticos, comparativos e estratégias para usar IA no seu negócio.</p>
      <div class="search-wrap">
        <input
          type="text"
          id="blog-search"
          class="search-input"
          placeholder="Buscar artigos..."
          autocomplete="off"
        />
        <button class="search-btn" id="search-btn">Buscar</button>
      </div>
    </div>

    <div class="hero-right">
      <a href={`/blog/${featured.slug}`} class="featured-card">
        <span class="featured-tag">Destaque</span>
        <h2>{featured.title}</h2>
        <p>{featured.description}</p>
        <div class="featured-meta">{featured.date}</div>
        <span class="featured-cta">Ler artigo →</span>
      </a>
    </div>
  </div>

  <!-- ── Category sections ── -->
  <div id="blog-sections">
    {sections.map(section => (
      <div class="category-section" data-section={section.id}>
        <div class="section-header">
          <h2>{section.title}</h2>
          <a href={`#${section.id}`}>Ver todos →</a>
        </div>
        <div class="cards-grid">
          {section.items.map(item => (
            <a
              href={`/blog/${item.slug}`}
              class="article-card"
              data-title={item.title.toLowerCase()}
            >
              <span class="card-tag">{item.tag}</span>
              <h3>{item.title}</h3>
              <p class="card-desc">{item.description.slice(0, 100)}{item.description.length > 100 ? '…' : ''}</p>
              <div class="card-footer">
                <span class="card-date">{item.date}</span>
                <span class="card-link">Ler artigo →</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    ))}
  </div>

  <div class="no-results" id="no-results">Nenhum artigo encontrado para esta busca.</div>
</Base>

<script is:inline>
  (function () {
    const input  = document.getElementById('blog-search');
    const btn    = document.getElementById('search-btn');
    const noRes  = document.getElementById('no-results');

    function filter() {
      const q = input.value.toLowerCase().trim();
      const cards    = document.querySelectorAll('.article-card');
      const sections = document.querySelectorAll('.category-section');

      cards.forEach(card => {
        const match = q === '' || card.dataset.title.includes(q);
        card.style.display = match ? '' : 'none';
      });

      let anyVisible = false;
      sections.forEach(section => {
        const visible = q === '' || [...section.querySelectorAll('.article-card')]
          .some(c => c.style.display !== 'none');
        section.style.display = visible ? '' : 'none';
        if (visible) anyVisible = true;
      });

      noRes.style.display = (!anyVisible && q !== '') ? 'block' : 'none';
    }

    input.addEventListener('input', filter);
    btn.addEventListener('click', filter);
    input.addEventListener('keydown', function (e) {
      if (e.key === 'Enter') filter();
    });
  })();
</script>
