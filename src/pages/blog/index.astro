---
import Base from '../../layouts/Base.astro';
import { posts as allPosts } from '../../data/blog-posts';

const posts = [...allPosts]
  .sort((a, b) => new Date(b.date).getTime() - new Date(a.date).getTime())
  .map(p => ({ ...p, url: `/blog/${p.slug}` }));
---

<style>
  .breadcrumb { display: flex; gap: 2px; align-items: center; font-size: 12px; color: #bbb; margin-bottom: 28px; flex-wrap: wrap; letter-spacing: 0.01em; }
  .breadcrumb a { color: #999; text-decoration: none; padding: 2px 4px; border-radius: 4px; transition: color 0.15s ease, background 0.15s ease; }
  .breadcrumb a:hover { color: #1D9E75; background: #f0faf6; }
  .breadcrumb span { color: #ddd; font-size: 10px; margin: 0 1px; user-select: none; }
  .post-card {
    display: block;
    padding: 28px;
    border: 1px solid #eee;
    border-radius: 14px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
    margin-bottom: 16px;
  }
  .post-card:hover {
    border-color: #1D9E75;
    box-shadow: 0 2px 12px rgba(29, 158, 117, 0.08);
  }
  .post-card h2 { font-size: 17px; font-weight: 600; color: #1a1a1a; margin-bottom: 8px; line-height: 1.4; }
  .post-card p  { font-size: 14px; color: #666; line-height: 1.6; margin-bottom: 12px; }
  .post-card .meta { font-size: 12px; color: #aaa; }
  .post-card .read-more { font-size: 13px; color: #1D9E75; font-weight: 500; }
</style>

<Base
  title="Blog — Buskai.net"
  description="Conteúdo sobre IA para empreendedores brasileiros: guias, comparações e dicas práticas."
>
  <div class="breadcrumb">
    <a href="/">Início</a><span>›</span>Blog
  </div>

  <h1 style="font-size:28px;font-weight:700;margin-bottom:8px;color:#1a1a1a;">Blog</h1>
  <p style="font-size:15px;color:#555;margin-bottom:40px;">Conteúdo sobre IA para empreendedores brasileiros.</p>

  {posts.length === 0 ? (
    <div style="padding:48px;background:#f9f9f9;border-radius:12px;text-align:center;color:#888;">
      Nenhum artigo publicado ainda. Em breve.
    </div>
  ) : (
    posts.map(post => (
      <a href={post.url} class="post-card">
        <h2>{post.title}</h2>
        <p>{post.description}</p>
        <div style="display:flex;justify-content:space-between;align-items:center;">
          <span class="meta">{new Date(post.date).toLocaleDateString('pt-BR', { day: 'numeric', month: 'long', year: 'numeric' })}</span>
          <span class="read-more">Ler artigo →</span>
        </div>
      </a>
    ))
  )}
</Base>
