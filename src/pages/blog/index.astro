  'ferramentas-ia-reunioes-produtividade': { title: 'Ferramentas de IA para reuniões e produtividade em equipe em 2026', description: 'As melhores ferramentas de IA para transcrever, resumir e organizar reuniões.', date: '11 de junho de 2026', slug: 'ferramentas-ia-reunioes-produtividade' },
  'como-escolher-assistente-ia-para-sua-empresa': { title: 'Como escolher o melhor assistente de IA para sua empresa em 2026', description: 'ChatGPT, Claude, Gemini ou Copilot? Compare os principais assistentes de IA para o seu negócio.', date: '10 de junho de 2026', slug: 'como-escolher-assistente-ia-para-sua-empresa' },
  '5-ferramentas-ia-empreendedor-brasileiro': { title: '5 ferramentas de IA que todo empreendedor brasileiro deveria conhecer em 2026', description: 'Descubra as 5 ferramentas de IA que estão transformando negócios brasileiros.', date: '8 de junho de 2026', slug: '5-ferramentas-ia-empreendedor-brasileiro' },
  'como-automatizar-atendimento-whatsapp-ia': { title: 'Como automatizar o atendimento no WhatsApp com IA em 2026', description: 'Descubra como usar IA para automatizar o atendimento no WhatsApp da sua empresa.', date: '19 de maio de 2026', slug: 'como-automatizar-atendimento-whatsapp-ia' },
  'ia-atendimento-clientes': { title: 'Como usar IA para atender clientes sem contratar mais pessoas', description: 'Descubra como usar IA no atendimento ao cliente da sua empresa reduzindo tempo e custos.', date: '8 de junho de 2026', slug: 'ia-atendimento-clientes' },
  'melhores-ferramentas-ia-rh-recrutamento-brasil': { title: 'Melhores ferramentas de IA para RH e recrutamento no Brasil em 2026', description: 'Compare as melhores ferramentas de IA para RH e recrutamento no Brasil.', date: '5 de junho de 2026', slug: 'melhores-ferramentas-ia-rh-recrutamento-brasil' },
