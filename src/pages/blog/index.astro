  'melhores-crms-para-pequenas-empresas-brasileiras': { title: 'Melhores CRMs para pequenas empresas brasileiras em 2026', description: 'Compare os melhores CRMs para PMEs brasileiras: HubSpot, Pipedrive, RD Station, Moskit e Agendor.', date: '12 de maio de 2026', slug: 'melhores-crms-para-pequenas-empresas-brasileiras' },
