  <div class="breadcrumb">
    <a href="/">Início</a><span>›</span>
    <a href="/blog">Blog</a><span>›</span>
    IA para pequenas empresas
  </div>

  <div class="page-layout">
    <aside class="sidebar">
      <div class="sidebar-title">Neste artigo</div>
      <nav class="sidebar-nav" aria-label="Sumário">
        <ol>
          <li><a href="#comunicacao">1. Comunicação</a></li>
          <li><a href="#atendimento">2. Atendimento</a></li>
          <li><a href="#organizacao">3. Organização</a></li>
