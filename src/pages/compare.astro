---
import Base from '../layouts/Base.astro';
import { getCategories } from '../lib/airtable.js';
import { curatedComparisons } from '../lib/comparisons.js';

const categories = await getCategories();
---

<style>
  .kicker {
    font-family: var(--mono); font-size: 11px; color: var(--accent);
    letter-spacing: .16em; text-transform: uppercase; margin: 24px 0 10px; display: block;
  }
  h1 { font-size: clamp(32px, 4.5vw, 48px); font-weight: 700; letter-spacing: -.03em; margin: 0 0 8px; }
  .lead { font-size: 15px; color: var(--text-dim); margin-bottom: 40px; max-width: 60ch; line-height: 1.6; }
  .builder {
    padding: 24px; border: 1px solid var(--line-2); border-radius: var(--radius);
    margin-bottom: 48px; background: var(--bg-2);
  }
  .builder h2 { font-size: 16px; font-weight: 600; margin: 0 0 20px; letter-spacing: -.01em; }
  .compare-form-grid {
    display: grid; grid-template-columns: 1fr 1fr 1fr auto;
    gap: 12px; align-items: end;
  }
  .compare-form-grid label {
    font-family: var(--mono); font-size: 11px; color: var(--text-dim);
    display: block; margin-bottom: 6px; text-transform: uppercase; letter-spacing: .08em;
  }
  .compare-form-grid select {
    width: 100%; padding: 9px 12px; border: 1px solid var(--line-2);
    border-radius: 10px; font-size: 13px; background: var(--bg);
    color: var(--text); font-family: var(--sans);
  }
  #btn-compare { opacity: 0.5; }
  .pop-h { font-size: 22px; font-weight: 600; letter-spacing: -.02em; margin: 0 0 16px; }
  .pop-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 12px; }
  .pop-grid a {
    padding: 16px 20px; border: 1px solid var(--line); border-radius: 12px;
    background: var(--bg-2); display: flex; justify-content: space-between; align-items: center;
    transition: border-color .15s ease;
  }
  .pop-grid a:hover { border-color: var(--accent); }
  .pop-grid .pair { font-size: 14px; font-weight: 600; color: var(--text); }
  .pop-grid .pair .vs-m { font-family: var(--mono); font-size: 10px; color: var(--text-dim); font-weight: 400; padding: 0 4px; }
  .pop-grid .cat { font-family: var(--mono); font-size: 11px; color: var(--text-dim); }
  @media (max-width: 800px) {
    .compare-form-grid { grid-template-columns: 1fr; }
    .compare-form-grid button { width: 100%; }
    .pop-grid { grid-template-columns: 1fr; }
  }
</style>

<Base title="Comparar Ferramentas de IA — Buskai.net">
  <div class="crumb">
    <a href="/">home</a><span class="sep">/</span><span class="cur">comparar</span>
  </div>

  <span class="kicker">▲ BENCH COMPARISON</span>
  <h1>Comparar ferramentas de IA</h1>
  <p class="lead">Selecione uma categoria e duas tools para comparar lado a lado — preço, plano grátis, suporte PT e disponibilidade no Brasil.</p>

  <div class="builder">
    <h2>Monte sua comparação</h2>
    <div class="compare-form-grid">
      <div>
        <label>Categoria</label>
        <select id="sel-category">
          <option value="">Selecione uma categoria...</option>
          {categories.map(cat => (
            <option value={cat.Slug}>{cat.Name}</option>
          ))}
        </select>
      </div>
      <div>
        <label>Ferramenta A</label>
        <select id="sel-toolA" disabled>
          <option value="">Selecione uma ferramenta...</option>
        </select>
      </div>
      <div>
        <label>Ferramenta B</label>
        <select id="sel-toolB" disabled>
          <option value="">Selecione uma ferramenta...</option>
        </select>
      </div>
      <button id="btn-compare" class="btn primary" disabled>
        Comparar →
      </button>
    </div>
  </div>

  <h2 class="pop-h">Comparações populares</h2>
  <div class="pop-grid">
    {curatedComparisons.map(({ category, slugA, slugB }) => {
      const catName = category.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
      const labelA = slugA.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
      const labelB = slugB.replace(/-/g, ' ').replace(/\b\w/g, l => l.toUpperCase());
      return (
        <a href={'/compare/' + category + '/' + slugA + '-vs-' + slugB}>
          <span class="pair">{labelA} <span class="vs-m">vs</span> {labelB}</span>
          <span class="cat">{catName}</span>
        </a>
      );
    })}
  </div>
</Base>

<script>
  const categorySelect = document.getElementById('sel-category');
  const toolASelect = document.getElementById('sel-toolA');
  const toolBSelect = document.getElementById('sel-toolB');
  const compareBtn = document.getElementById('btn-compare');
  const cache = {};

  categorySelect.addEventListener('change', async () => {
    const slug = categorySelect.value;
    if (!slug) return;
    toolASelect.innerHTML = '<option>Carregando...</option>';
    toolBSelect.innerHTML = '<option>Carregando...</option>';
    toolASelect.disabled = true;
    toolBSelect.disabled = true;
    if (!cache[slug]) {
      const res = await fetch('/api/tools-by-category?category=' + slug);
      cache[slug] = await res.json();
    }
    const opts = cache[slug].map(t => '<option value="' + t.slug + '">' + t.Name + '</option>').join('');
    toolASelect.innerHTML = '<option value="">Selecione a ferramenta A...</option>' + opts;
    toolBSelect.innerHTML = '<option value="">Selecione a ferramenta B...</option>' + opts;
    toolASelect.disabled = false;
    toolBSelect.disabled = false;
  });

  function checkReady() {
    const ok = categorySelect.value && toolASelect.value && toolBSelect.value && toolASelect.value !== toolBSelect.value;
    compareBtn.disabled = !ok;
    compareBtn.style.opacity = ok ? '1' : '0.5';
  }

  toolASelect.addEventListener('change', checkReady);
  toolBSelect.addEventListener('change', checkReady);

  compareBtn.addEventListener('click', () => {
    window.location.href = '/compare/' + categorySelect.value + '/' + toolASelect.value + '-vs-' + toolBSelect.value;
  });
</script>
