---
// src/pages/alternativas/[slug].astro
// Página pSEO de alternativas — Buskai.net
// Lê da tabela "Alternativas" no Airtable e gera /alternativas/[slug]

import Base from '../../layouts/Base.astro';

export const prerender = false; // SSR via Vercel

const AIRTABLE_TOKEN = import.meta.env.AIRTABLE_API_KEY;
const BASE_ID = import.meta.env.AIRTABLE_BASE_ID;
const ALTERNATIVAS_TABLE = "tbl1FgI1foVC7n2HM";
const TOOLS_TABLE = "tbl66b2aHBKUkkAF0";

const { slug } = Astro.params;

// ─── 1. Busca o registro de alternativa pelo slug_referencia ────────────────
const searchRes = await fetch(
  `https://api.airtable.com/v0/${BASE_ID}/${ALTERNATIVAS_TABLE}?` +
  new URLSearchParams({
    filterByFormula: `AND({slug_referencia} = "${slug}", {published} = 1)`,
    maxRecords: '1',
  }),
  { headers: { Authorization: `Bearer ${AIRTABLE_TOKEN}` } }
);

const searchData = await searchRes.json();

if (!searchData.records || searchData.records.length === 0) {
  return Astro.redirect('/404');
}

const page = searchData.records[0].fields;

// ─── 2. Busca as ferramentas alternativas linkadas ──────────────────────────
const toolIds: string[] = page.alternativas || [];

let tools: any[] = [];

if (toolIds.length > 0) {
  const formula =
    'AND(OR(' + toolIds.map((id) => `RECORD_ID() = "${id}"`).join(',') + '),{status}="published")';

  const toolsRes = await fetch(
    `https://api.airtable.com/v0/${BASE_ID}/${TOOLS_TABLE}?` +
    new URLSearchParams({ filterByFormula: formula }),
    { headers: { Authorization: `Bearer ${AIRTABLE_TOKEN}` } }
  );

  const toolsData = await toolsRes.json();
  tools = toolsData.records?.map((r: any) => r.fields) ?? [];
}

// ─── 3. Meta SEO ────────────────────────────────────────────────────────────
const title = `Melhores alternativas ao ${page.nome_referencia} com IA — Buskai.net`;
const description = `Confira as ${tools.length} melhores alternativas ao ${page.nome_referencia} com IA para o mercado brasileiro. Comparamos preço, suporte em português e disponibilidade no Brasil.`;
const canonicalUrl = `https://www.buskai.net/alternativas/${slug}`;
---

<Base title={title}>

  <style>
    .alt-hero {
      padding: 48px 0 36px;
      text-align: center;
      border-bottom: 1px solid var(--line);
      margin-bottom: 40px;
    }
    .alt-hero h1 {
      font-size: clamp(28px, 4vw, 44px);
      font-weight: 700;
      letter-spacing: -.03em;
      margin: 0 0 12px;
      line-height: 1.2;
    }
    .alt-hero h1 span { color: var(--accent); }
    .alt-subtitle {
      font-size: 15px;
      color: var(--text-dim);
      max-width: 560px;
      margin: 0 auto 20px;
      line-height: 1.6;
    }
    .alt-badges {
      display: flex;
      gap: 8px;
      justify-content: center;
      flex-wrap: wrap;
    }
    .alt-badge {
      font-family: var(--mono);
      font-size: 11px;
      padding: 4px 10px;
      border-radius: 999px;
      border: 1px solid var(--accent);
      color: var(--accent);
      background: color-mix(in srgb, var(--accent) 10%, transparent);
    }

    .alt-section { margin-bottom: 48px; }
    .alt-section h2 {
      font-size: 20px;
      font-weight: 600;
      letter-spacing: -.02em;
      margin: 0 0 16px;
    }
    .alt-motivo p {
      font-size: 15px;
      color: var(--text-dim);
      line-height: 1.7;
      max-width: 720px;
    }

    .tools-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 12px;
    }
    .tool-card {
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 20px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--bg-2);
      text-decoration: none;
      color: var(--text);
      transition: border-color .15s ease;
    }
    .tool-card:hover { border-color: var(--accent); }
    .tool-card__header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
    }
    .tool-card__header h3 {
      font-size: 15px;
      font-weight: 600;
      margin: 0;
      letter-spacing: -.01em;
    }
    .tag-free {
      font-family: var(--mono);
      font-size: 10px;
      padding: 2px 6px;
      border-radius: 4px;
      background: color-mix(in srgb, var(--accent) 15%, transparent);
      color: var(--accent);
      white-space: nowrap;
    }
    .tool-card__tagline {
      font-size: 13px;
      color: var(--text-dim);
      line-height: 1.5;
      flex: 1;
    }
    .tool-card__badges {
      display: flex;
      flex-wrap: wrap;
      gap: 4px;
    }
    .tool-badge {
      font-family: var(--mono);
      font-size: 10px;
      padding: 2px 7px;
      border-radius: 4px;
      border: 1px solid var(--line-2);
      color: var(--text-dim);
    }
    .tool-badge--br { border-color: var(--accent); color: var(--accent); }
    .tool-card__cta {
      font-family: var(--mono);
      font-size: 11px;
      color: var(--accent);
      margin-top: 4px;
    }

    .alt-editorial {
      font-size: 15px;
      color: var(--text-dim);
      line-height: 1.8;
      max-width: 720px;
    }
    .alt-editorial p { margin-bottom: 16px; }

    .alt-cta {
      padding: 40px 24px;
      border: 1px solid var(--line);
      border-radius: var(--radius);
      background: var(--bg-2);
      text-align: center;
      margin-top: 48px;
    }
    .alt-cta p {
      font-size: 15px;
      color: var(--text-dim);
      margin-bottom: 16px;
    }
    .btn-primary {
      display: inline-flex;
      align-items: center;
      padding: 10px 22px;
      border-radius: 10px;
      background: var(--accent);
      color: #000;
      font-weight: 600;
      font-size: 14px;
      text-decoration: none;
      transition: opacity .15s;
    }
    .btn-primary:hover { opacity: 0.85; }

    @media (max-width: 600px) {
      .tools-grid { grid-template-columns: 1fr; }
    }
  </style>

  <!-- BREADCRUMB -->
  <div class="crumb">
    <a href="/">home</a><span class="sep">/</span>
    <span class="cur">alternativas ao {page.nome_referencia}</span>
  </div>

  <!-- HERO -->
  <div class="alt-hero">
    <h1>
      Melhores alternativas ao<br/>
      <span>{page.nome_referencia}</span> com IA
    </h1>
    <p class="alt-subtitle">{page.descricao_referencia}</p>
    <div class="alt-badges">
      <span class="alt-badge">{tools.length} alternativas curadas</span>
      {page.contexto_brasil && (
        <span class="alt-badge">🇧🇷 Foco no Brasil</span>
      )}
    </div>
  </div>

  <!-- POR QUE BUSCAR ALTERNATIVA -->
  {page.motivo_busca && (
    <div class="alt-section alt-motivo">
      <h2>Por que buscar alternativas ao {page.nome_referencia}?</h2>
      <p>{page.motivo_busca}</p>
    </div>
  )}

  <!-- CARDS -->
  <div class="alt-section">
    <h2>As melhores alternativas</h2>
    <div class="tools-grid">
      {tools.map((tool) => (
        <a href={`/tools/${tool.slug}`} class="tool-card">
          <div class="tool-card__header">
            <h3>{tool.Name}</h3>
            {tool.has_free_plan && <span class="tag-free">Plano grátis</span>}
          </div>
          <p class="tool-card__tagline">{tool.tagline_pt || tool.tagline_en}</p>
          <div class="tool-card__badges">
            {tool.works_in_brazil && <span class="tool-badge tool-badge--br">🇧🇷 Brasil</span>}
            {tool.has_pt_support && <span class="tool-badge tool-badge--br">PT-BR</span>}
            {tool.starting_price_usd
              ? <span class="tool-badge">A partir de {tool.currency === 'BRL' ? 'R$' : '$'}{tool.starting_price_usd}/mês</span>
              : <span class="tool-badge">{tool.has_free_plan ? 'Grátis' : 'Consultar preço'}</span>
            }
          </div>
          <span class="tool-card__cta">Ver ferramenta →</span>
        </a>
      ))}
    </div>
  </div>

  <!-- COMO ESCOLHER -->
  {page.como_escolher && (
    <div class="alt-section">
      <h2>Como escolher a melhor alternativa para você</h2>
      <div class="alt-editorial">
        {page.como_escolher.split('\n').filter((p: string) => p.trim()).map((p: string) => (
          <p>{p}</p>
        ))}
      </div>
    </div>
  )}

  <!-- CTA FINAL -->
  <div class="alt-cta">
    <p>Quer comparar duas ferramentas lado a lado?</p>
    <a href="/compare" class="btn-primary">Comparar ferramentas →</a>
  </div>

</Base>
