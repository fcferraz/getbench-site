---
import Anthropic from '@anthropic-ai/sdk';
import Base from '../../../layouts/Base.astro';
import { getTools, getCompareCache, saveCompareCache } from '../../../lib/airtable.js';
import { categoryCriteria } from '../../../lib/comparisons.js';

const { category, slug } = Astro.params;
const vsIndex = slug.indexOf('-vs-');
const slugA = slug.substring(0, vsIndex);
const slugB = slug.substring(vsIndex + 4);

const tools = await getTools();
const toolsBySlug = Object.fromEntries(tools.map(t => [t.slug, t]));

const toolA = toolsBySlug[slugA];
const toolB = toolsBySlug[slugB];
const criteria = categoryCriteria[category] || [];

function formatValue(tool, criterion) {
  if (!tool) return '-';
  const val = tool[criterion.key];
  if (criterion.type === 'boolean') return val ? 'Sim' : 'Não';
  if (criterion.type === 'price') return val === 0 ? 'Plano gratuito disponível' : val ? '$' + val + '/mês' : '-';
  if (criterion.key === 'pricing_model') {
    const map = { per_month: 'Mensal', per_user: 'Por usuário', custom: 'Sob consulta' };
    return map[val] || val || '-';
  }
  return val || '-';
}

function getColor(tool, criterion) {
  if (!tool || criterion.type !== 'boolean') return '#555';
  return tool[criterion.key] ? '#0F6E56' : '#888';
}

const categoryName = category.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

function getVerdictBulletsFallback(tool) {
  const bullets = [];
  if (tool?.has_free_plan && tool?.starting_price_usd === 0) {
    bullets.push('Você precisa de uma opção gratuita para começar');
  } else if (tool?.has_free_plan) {
    bullets.push('Você quer testar antes de assinar (plano grátis disponível)');
  } else if (tool?.starting_price_usd) {
    bullets.push(tool.starting_price_usd < 30
      ? `Seu orçamento é enxuto (a partir de $${tool.starting_price_usd}/mês)`
      : `Você busca uma solução robusta ($${tool.starting_price_usd}/mês)`);
  }
  if (tool?.works_in_brazil) bullets.push('Sua operação é baseada no Brasil');
  if (tool?.has_pt_support) bullets.push('Sua equipe trabalha em português');
  if (tool?.accepts_brl && bullets.length < 3) bullets.push('Você prefere pagar em reais (BRL)');
  if (bullets.length < 2) bullets.push('Você prioriza integrações e recursos avançados');
  return bullets.slice(0, 3);
}

function toolSummary(tool) {
  if (!tool) return 'Ferramenta não encontrada';
  return JSON.stringify({
    name: tool.Name,
    tagline: tool.tagline_pt || tool.tagline_en || '',
    description_pt: tool.description_pt?.substring(0, 400) || '',
    starting_price_usd: tool.starting_price_usd,
    has_free_plan: tool.has_free_plan,
    pricing_model: tool.pricing_model,
    works_in_brazil: tool.works_in_brazil,
    works_in_mexico: tool.works_in_mexico,
    accepts_brl: tool.accepts_brl,
    has_pt_support: tool.has_pt_support,
    has_latam_data: tool.has_latam_data,
    latam_note_pt: tool.latam_note_pt,
    categories: tool.categories,
  });
}

let bulletsA: string[] = [];
let bulletsB: string[] = [];

if (toolA && toolB) {
  // 1. Try the Airtable cache first — avoids a Claude call on repeat views.
  const cached = await getCompareCache(slugA, slugB);
  if (cached) {
    bulletsA = cached.bulletsA.slice(0, 3);
    bulletsB = cached.bulletsB.slice(0, 3);
  } else if (process.env.ANTHROPIC_API_KEY) {
    // 2. Cache miss — generate with Claude, then persist for next time.
    try {
      const client = new Anthropic({ apiKey: process.env.ANTHROPIC_API_KEY });
      const response = await client.messages.create({
        model: 'claude-haiku-4-5',
        max_tokens: 512,
        messages: [{
          role: 'user',
          content: `Você é um especialista em ferramentas de IA para empresas de LATAM. Compare as duas ferramentas abaixo e gere bullets de decisão em português.

Ferramenta A: ${toolSummary(toolA)}

Ferramenta B: ${toolSummary(toolB)}

Responda APENAS com JSON válido neste formato exato (sem markdown, sem explicações):
{
  "bulletsA": ["bullet 1", "bullet 2", "bullet 3"],
  "bulletsB": ["bullet 1", "bullet 2", "bullet 3"]
}

Regras:
- Cada lista deve ter 2-3 bullets
- Cada bullet começa com "Você " e descreve um perfil de usuário que se beneficia dessa ferramenta
- Os bullets devem ser DIFERENTES entre as duas ferramentas — cada uma tem seu ponto forte distinto
- Seja específico com dados reais (preços, recursos, mercado)
- Escreva em português brasileiro, tom profissional mas direto`
        }]
      });

      const text = response.content[0].type === 'text' ? response.content[0].text : '';
      const clean = text.replace(/```json\n?/g, '').replace(/```\n?/g, '').trim();
      const parsed = JSON.parse(clean);
      if (Array.isArray(parsed.bulletsA) && Array.isArray(parsed.bulletsB)) {
        bulletsA = parsed.bulletsA.slice(0, 3);
        bulletsB = parsed.bulletsB.slice(0, 3);
        // 3. Persist for next time. Awaited so the write survives the
        //    serverless function freeze that follows the response on Vercel.
        await saveCompareCache(slugA, slugB, bulletsA, bulletsB).catch(() => {});
      }
    } catch (err) {
      console.error('[compare] Claude verdict error:', err?.message ?? err);
    }
  }
}

if (bulletsA.length === 0) bulletsA = getVerdictBulletsFallback(toolA);
if (bulletsB.length === 0) bulletsB = getVerdictBulletsFallback(toolB);
---

<style>
  .breadcrumb { display: flex; gap: 2px; align-items: center; font-size: 12px; color: #bbb; margin-bottom: 28px; flex-wrap: wrap; letter-spacing: 0.01em; }
  .breadcrumb a { color: #999; text-decoration: none; padding: 2px 4px; border-radius: 4px; transition: color 0.15s ease, background 0.15s ease; }
  .breadcrumb a:hover { color: #1D9E75; background: #f0faf6; }
  .breadcrumb span { color: #ddd; font-size: 10px; margin: 0 1px; user-select: none; }
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 32px; }
  .verdict-box { border: 1px solid #1D9E75; border-radius: 12px; background: #f0faf6; padding: 28px; margin-bottom: 32px; }
  .verdict-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
  @media (max-width: 640px) {
    .two-col { grid-template-columns: 1fr; }
    .verdict-grid { grid-template-columns: 1fr; }
  }
</style>

<Base title={toolA?.Name + ' vs ' + toolB?.Name + ' — Buskai.net'}>
  <div class="breadcrumb">
    <a href="/">Início</a><span>›</span>
    <a href="/categories">Categorias</a><span>›</span>
    <a href={'/category/' + category}>{categoryName}</a><span>›</span>
    {toolA?.Name} vs {toolB?.Name}
  </div>

  <h1 style="font-size:28px;font-weight:600;margin-bottom:8px;">{toolA?.Name} vs {toolB?.Name}</h1>
  <p style="font-size:15px;color:#555;margin-bottom:40px;">Comparação lado a lado para <strong>{categoryName}</strong> — curada para empresas de LATAM.</p>

  <div class="two-col">
    {[toolA, toolB].map(tool => (
      <div style="padding:24px;border:1px solid #eee;border-radius:12px;text-align:center;">
        <h2 style="font-size:20px;font-weight:600;margin-bottom:8px;">{tool?.Name}</h2>
        <p style="font-size:13px;color:#555;margin-bottom:16px;">{tool?.tagline_pt || tool?.tagline_en || ''}</p>
        <div style="font-size:18px;font-weight:600;margin-bottom:12px;">
          {tool?.starting_price_usd === 0 ? 'Gratuito' : tool?.starting_price_usd ? 'A partir de $' + tool.starting_price_usd + '/mês' : tool?.pricing_model === 'free' ? 'Gratuito' : 'Ver site'}
        </div>
        <a href={tool?.affiliate_url || tool?.website} target="_blank" rel="noopener noreferrer" style="display:inline-block;padding:8px 20px;background:#1D9E75;color:#fff;border-radius:8px;text-decoration:none;font-size:13px;">Visitar {tool?.Name} →</a>
      </div>
    ))}
  </div>

  <div style="border:1px solid #eee;border-radius:12px;overflow:hidden;margin-bottom:32px;">
    <div style="display:grid;grid-template-columns:1fr 1fr 1fr;background:#f9f9f9;padding:12px 20px;border-bottom:1px solid #eee;">
      <div style="font-size:12px;font-weight:600;color:#888;text-transform:uppercase;">Critério</div>
      <div style="font-size:13px;font-weight:600;text-align:center;">{toolA?.Name}</div>
      <div style="font-size:13px;font-weight:600;text-align:center;">{toolB?.Name}</div>
    </div>
    {criteria.map((c, i) => (
      <div style={'display:grid;grid-template-columns:1fr 1fr 1fr;padding:14px 20px;align-items:center;' + (i < criteria.length - 1 ? 'border-bottom:1px solid #f0f0f0;' : '')}>
        <div style="font-size:13px;color:#555;">{c.label}</div>
        <div style={'font-size:13px;font-weight:500;text-align:center;color:' + getColor(toolA, c)}>{formatValue(toolA, c)}</div>
        <div style={'font-size:13px;font-weight:500;text-align:center;color:' + getColor(toolB, c)}>{formatValue(toolB, c)}</div>
      </div>
    ))}
  </div>

  <div class="two-col">
    {[toolA, toolB].filter(t => t?.latam_note_pt).map(tool => (
      <div style="padding:16px 20px;background:#E1F5EE;border-radius:12px;">
        <h3 style="font-size:13px;font-weight:600;color:#0F6E56;margin-bottom:6px;">{tool?.Name} no Brasil</h3>
        <p style="font-size:13px;color:#085041;line-height:1.6;">{tool?.latam_note_pt}</p>
      </div>
    ))}
  </div>

  <div class="two-col">
    {[toolA, toolB].map(tool => (
      <div style="padding:24px;border:1px solid #eee;border-radius:12px;">
        <h3 style="font-size:15px;font-weight:600;margin-bottom:12px;">Sobre {tool?.Name}</h3>
        <p style="font-size:13px;color:#444;line-height:1.7;">{tool?.description_pt?.substring(0, 300)}...</p>
        <a href={'/tools/' + tool?.slug} style="font-size:12px;color:#1D9E75;text-decoration:none;margin-top:8px;display:inline-block;">Ver ficha completa de {tool?.Name} →</a>
      </div>
    ))}
  </div>

  <div class="verdict-box">
    <h2 style="font-size:18px;font-weight:600;margin-bottom:20px;color:#0F6E56;">Qual escolher?</h2>
    <div class="verdict-grid">
      {([toolA, toolB] as const).map((tool, i) => {
        const bullets = i === 0 ? bulletsA : bulletsB;
        return (
          <div style="background:#fff;border:1px solid #c8ead9;border-radius:10px;padding:20px;">
            <h3 style="font-size:14px;font-weight:600;color:#0F6E56;margin-bottom:14px;">Escolha {tool?.Name} se...</h3>
            <ul style="list-style:none;padding:0;margin:0;display:flex;flex-direction:column;gap:10px;">
              {bullets.map(b => (
                <li style="font-size:13px;color:#333;display:flex;gap:8px;align-items:flex-start;line-height:1.5;">
                  <span style="color:#1D9E75;font-weight:700;flex-shrink:0;margin-top:1px;">→</span>{b}
                </li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </div>

  <div class="two-col" style="margin-bottom:0;">
    {[toolA, toolB].map(tool => (
      <div style="padding:24px;border:1px solid #eee;border-radius:12px;text-align:center;background:#f9f9f9;">
        <p style="font-size:14px;color:#555;margin-bottom:12px;">Pronto para experimentar {tool?.Name}?</p>
        <a href={tool?.affiliate_url || tool?.website} target="_blank" rel="noopener noreferrer" style="display:inline-block;padding:10px 24px;background:#1D9E75;color:#fff;border-radius:8px;text-decoration:none;font-size:13px;font-weight:500;">Começar →</a>
      </div>
    ))}
  </div>
</Base>
