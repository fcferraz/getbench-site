---
import Anthropic from '@anthropic-ai/sdk';
import Base from '../../../layouts/Base.astro';
import { getTools, getCompareCache, saveCompareCache } from '../../../lib/supabase.js';
import { categoryCriteria } from '../../../lib/comparisons.js';

const { category, slug } = Astro.params;
if (!slug || !slug.includes('-vs-')) {
  return Astro.redirect('/compare');
}
const vsIndex = slug.indexOf('-vs-');
const slugA = slug.substring(0, vsIndex);
const slugB = slug.substring(vsIndex + 4);

const tools = await getTools();
const toolsBySlug = Object.fromEntries(tools.map(t => [t.slug, t]));

const toolA = toolsBySlug[slugA];
const toolB = toolsBySlug[slugB];
const criteria = categoryCriteria[category] || [];

function formatValue(tool, criterion) {
  if (!tool) return '-';
  const val = tool[criterion.key];
  if (criterion.type === 'boolean') return val ? 'Sim' : 'Não';
  if (criterion.type === 'price') return val === 0 ? 'Plano gratuito disponível' : val ? '$' + val + '/mês' : '-';
  if (criterion.key === 'pricing_model') {
    const map = { per_month: 'Mensal', per_user: 'Por usuário', custom: 'Sob consulta' };
    return map[val] || val || '-';
  }
  return val || '-';
}

function getColor(tool, criterion) {
  if (!tool || criterion.type !== 'boolean') return 'var(--text-dim)';
  return tool[criterion.key] ? 'var(--accent)' : 'var(--text-dimmer)';
}

const categoryName = category.split('-').map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');

function getVerdictBulletsFallback(tool) {
  const bullets = [];
  if (tool?.has_free_plan && tool?.starting_price_usd === 0) {
    bullets.push('Você precisa de uma opção gratuita para começar');
  } else if (tool?.has_free_plan) {
    bullets.push('Você quer testar antes de assinar (plano grátis disponível)');
  } else if (tool?.starting_price_usd) {
    bullets.push(tool.starting_price_usd < 30
      ? `Seu orçamento é enxuto (a partir de $${tool.starting_price_usd}/mês)`
      : `Você busca uma solução robusta ($${tool.starting_price_usd}/mês)`);
  }
  if (tool?.works_in_brazil) bullets.push('Sua operação é baseada no Brasil');
  if (tool?.has_pt_support) bullets.push('Sua equipe trabalha em português');
  if (tool?.accepts_brl && bullets.length < 3) bullets.push('Você prefere pagar em reais (BRL)');
  if (bullets.length < 2) bullets.push('Você prioriza integrações e recursos avançados');
  return bullets.slice(0, 3);
}

function toolSummary(tool) {
  if (!tool) return 'Ferramenta não encontrada';
  return JSON.stringify({
    name: tool.Name,
    tagline: tool.tagline_pt || tool.tagline_en || '',
    description_pt: tool.description_pt?.substring(0, 400) || '',
    starting_price_usd: tool.starting_price_usd,
    has_free_plan: tool.has_free_plan,
    pricing_model: tool.pricing_model,
    works_in_brazil: tool.works_in_brazil,
    works_in_mexico: tool.works_in_mexico,
    accepts_brl: tool.accepts_brl,
    has_pt_support: tool.has_pt_support,
    has_latam_data: tool.has_latam_data,
    latam_note_pt: tool.latam_note_pt,
    categories: tool.categories,
  });
}

let bulletsA: string[] = [];
let bulletsB: string[] = [];

if (toolA && toolB) {
  // 1. Try the Airtable cache first — avoids a Claude call on repeat views.
  const cached = await getCompareCache(slugA, slugB);
  if (cached) {
    bulletsA = cached.bulletsA.slice(0, 3);
    bulletsB = cached.bulletsB.slice(0, 3);
  } else if (process.env.ANTHROPIC_API_KEY) {
    // 2. Cache miss — generate with Claude, then persist for next time.
    try {
      const client = new Anthropic({ apiKey: process.env.ANTHROPIC_API_KEY });
      const response = await client.messages.create({
        model: 'claude-haiku-4-5-20251001',
        max_tokens: 512,
        messages: [{
          role: 'user',
          content: `Você é um especialista em ferramentas de IA para empresas de LATAM. Compare as duas ferramentas abaixo e gere bullets de decisão em português.

Ferramenta A: ${toolSummary(toolA)}

Ferramenta B: ${toolSummary(toolB)}

Responda APENAS com JSON válido neste formato exato (sem markdown, sem explicações):
{
  "bulletsA": ["bullet 1", "bullet 2", "bullet 3"],
  "bulletsB": ["bullet 1", "bullet 2", "bullet 3"]
}

Regras:
- Cada lista deve ter 2-3 bullets
- Cada bullet começa com "Você " e descreve um perfil de usuário que se beneficia dessa ferramenta
- Os bullets devem ser DIFERENTES entre as duas ferramentas — cada uma tem seu ponto forte distinto
- Seja específico com dados reais (preços, recursos, mercado)
- Escreva em português brasileiro, tom profissional mas direto`
        }]
      });

      const text = response.content[0].type === 'text' ? response.content[0].text : '';
      const clean = text.replace(/```json\n?/g, '').replace(/```\n?/g, '').trim();
      const parsed = JSON.parse(clean);
      if (Array.isArray(parsed.bulletsA) && Array.isArray(parsed.bulletsB)) {
        bulletsA = parsed.bulletsA.slice(0, 3);
        bulletsB = parsed.bulletsB.slice(0, 3);
        // 3. Persist for next time. Awaited so the write survives the
        //    serverless function freeze that follows the response on Vercel.
        await saveCompareCache(slugA, slugB, bulletsA, bulletsB).catch(() => {});
      }
    } catch (err) {
      console.error('[compare] Claude verdict error:', err?.message ?? err);
    }
  }
}

if (bulletsA.length === 0) bulletsA = getVerdictBulletsFallback(toolA);
if (bulletsB.length === 0) bulletsB = getVerdictBulletsFallback(toolB);

const hostOf = (url) => { try { return new URL(url).hostname; } catch { return null; } };
const hostA = hostOf(toolA?.website);
const hostB = hostOf(toolB?.website);

const priceLabel = (tool) =>
  tool?.starting_price_usd === 0 ? 'Gratuito'
  : tool?.starting_price_usd ? 'A partir de $' + tool.starting_price_usd + '/mês'
  : tool?.pricing_model === 'free' ? 'Gratuito' : 'Ver site';
---

<style>
  .hero-cmp { margin-top: 32px; padding-bottom: 24px; border-bottom: 1px solid var(--line); }
  .hero-cmp .kicker {
    font-family: var(--mono); font-size: 11px; color: var(--accent);
    letter-spacing: .16em; text-transform: uppercase; margin-bottom: 10px; display: block;
  }
  .hero-cmp h1 {
    font-size: clamp(34px, 5vw, 58px); line-height: 1.05; letter-spacing: -.035em;
    font-weight: 700; margin: 0 0 10px;
  }
  .hero-cmp h1 .accent { color: var(--accent); }
  .hero-cmp p { color: var(--text-dim); font-size: 16px; line-height: 1.5; max-width: 62ch; margin: 0; }

  /* Tool slots */
  .picker {
    margin: 24px 0 20px;
    display: grid; grid-template-columns: 1fr 44px 1fr; gap: 10px; align-items: stretch;
  }
  .slot {
    border: 1px solid var(--line-2); background: var(--bg-2);
    border-radius: 12px; padding: 16px;
    display: flex; align-items: center; gap: 12px;
  }
  .slot .logo {
    width: 40px; height: 40px; border-radius: 10px; flex: none;
    display: grid; place-items: center; overflow: hidden;
    font-weight: 800; font-size: 16px; color: #fff;
    box-shadow: inset 0 0 0 1px rgba(0,0,0,.08);
  }
  .slot .logo img { width: 100%; height: 100%; object-fit: cover; }
  .slot .logo .fb { display: grid; place-items: center; width: 100%; height: 100%; }
  .slot.sa .logo .fb { background: linear-gradient(135deg, #8a7dff, #2f3bff); }
  .slot.sb .logo .fb { background: linear-gradient(135deg, #ffb74a, #ff6a5b); }
  .slot .name { font-weight: 700; font-size: 16px; letter-spacing: -.01em; }
  .slot .cat { font-family: var(--mono); font-size: 11px; color: var(--text-dim); margin-top: 2px; }
  .slot .price-tag { margin-left: auto; text-align: right; flex: none; }
  .slot .price-tag b { font-family: var(--mono); font-size: 13px; color: var(--text); display: block; }
  .slot .price-tag .btn { margin-top: 8px; font-size: 12px; padding: 6px 12px; }
  .vs {
    display: grid; place-items: center;
    font-family: var(--mono); font-size: 14px; color: var(--text-dim);
    border: 1px dashed var(--line); border-radius: 12px;
  }

  /* Matrix */
  .matrix {
    border: 1px solid var(--line); border-radius: 14px; overflow: hidden;
    background: var(--bg-2); margin-bottom: 32px;
  }
  .mx-head, .mx-row { display: grid; grid-template-columns: 200px repeat(2, 1fr); align-items: stretch; }
  .mx-head { border-bottom: 1px solid var(--line); background: color-mix(in oklab, var(--bg) 50%, var(--bg-2)); }
  .mx-head > div { padding: 16px 18px; border-right: 1px solid var(--line); }
  .mx-head > div:last-child { border-right: 0; }
  .mx-head .label {
    font-family: var(--mono); font-size: 11px; color: var(--text-dim);
    letter-spacing: .1em; text-transform: uppercase; display: flex; align-items: center;
  }
  .mx-head h4 { margin: 0; font-size: 15px; font-weight: 700; letter-spacing: -.01em; text-align: center; }
  .mx-row { border-bottom: 1px solid var(--line); }
  .mx-row:last-child { border-bottom: 0; }
  .mx-row > div {
    padding: 14px 18px; border-right: 1px solid var(--line);
    font-size: 14px; display: flex; align-items: center; gap: 8px;
  }
  .mx-row > div:last-child { border-right: 0; }
  .mx-row .criterion {
    font-family: var(--mono); font-size: 12px; color: var(--text-dim); letter-spacing: .04em;
  }
  .mx-row .cell { justify-content: center; text-align: center; font-weight: 500; }

  /* Verdict */
  .verdict {
    margin: 10px 0 32px; padding: 24px 28px;
    border: 1px solid var(--accent); border-radius: 14px;
    background:
      radial-gradient(400px 200px at 0% 0%, var(--accent-glow), transparent 70%),
      var(--bg-2);
  }
  .verdict .badge {
    font-family: var(--mono); font-size: 10px; letter-spacing: .16em;
    color: var(--accent); text-transform: uppercase; margin-bottom: 10px; display: block;
  }
  .verdict h2 { margin: 0 0 18px; font-size: 22px; font-weight: 600; letter-spacing: -.02em; }
  .verdict-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; }
  .verdict-grid .pc {
    background: var(--bg-2); border: 1px solid var(--line-2); border-radius: 12px; padding: 18px;
  }
  .verdict-grid h3 {
    font-family: var(--mono); font-size: 11px; color: var(--accent);
    letter-spacing: .1em; text-transform: uppercase; margin: 0 0 14px;
  }
  .verdict-grid ul { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 10px; }
  .verdict-grid li { font-size: 13px; color: var(--text-dim); display: flex; gap: 8px; align-items: flex-start; line-height: 1.5; }
  .verdict-grid li .arr { color: var(--accent); font-weight: 700; flex-shrink: 0; margin-top: 1px; }

  /* Notes + about */
  .two-col { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; margin-bottom: 32px; }
  .note-card {
    padding: 16px 20px; border: 1px solid var(--line); border-radius: 12px;
    background: color-mix(in oklab, var(--accent-glow) 35%, transparent);
  }
  .note-card h3 { font-size: 13px; font-weight: 600; color: var(--accent); margin: 0 0 6px; font-family: var(--mono); }
  .note-card p { font-size: 13px; color: var(--text-dim); line-height: 1.6; margin: 0; }
  .about-card { padding: 24px; border: 1px solid var(--line); border-radius: 12px; background: var(--bg-2); }
  .about-card h3 { font-size: 15px; font-weight: 600; margin: 0 0 12px; }
  .about-card p { font-size: 13px; color: var(--text-dim); line-height: 1.7; margin: 0 0 8px; }
  .about-card a { font-family: var(--mono); font-size: 12px; color: var(--accent); }
  .cta-card {
    padding: 24px; border: 1px solid var(--line); border-radius: 12px;
    text-align: center; background: var(--bg-2);
  }
  .cta-card p { font-size: 14px; color: var(--text-dim); margin: 0 0 12px; }

  @media (max-width: 800px) {
    .picker { grid-template-columns: 1fr; }
    .vs { display: none; }
    .matrix { overflow-x: auto; }
    .mx-head, .mx-row { min-width: 560px; }
    .two-col, .verdict-grid { grid-template-columns: 1fr; }
  }
</style>

<Base title={toolA?.Name + ' vs ' + toolB?.Name + ' — Buskai.net'}>
  <div class="crumb">
    <a href="/">home</a>
    <span class="sep">/</span>
    <a href="/categories">categorias</a>
    <span class="sep">/</span>
    <a href={'/category/' + category}>{category}</a>
    <span class="sep">/</span>
    <span class="cur">{slugA} · {slugB}</span>
  </div>

  <section class="hero-cmp">
    <span class="kicker">▲ COMPARAÇÃO · {categoryName}</span>
    <h1>{toolA?.Name} vs <span class="accent">{toolB?.Name}</span></h1>
    <p>Comparação lado a lado para <strong>{categoryName}</strong> — preço, plano grátis, suporte em português e disponibilidade no Brasil, curada para empresas de LATAM.</p>
  </section>

  <div class="picker">
    {[{ tool: toolA, host: hostA, cls: 'sa' }, { tool: toolB, host: hostB, cls: 'sb' }].map(({ tool, host, cls }, i) => (
      <>
        {i === 1 && <div class="vs">vs</div>}
        <div class={`slot ${cls}`}>
          <div class="logo">
            {host && <img src={`https://www.google.com/s2/favicons?domain=${host}&sz=128`} alt="" loading="lazy" onerror="this.style.display='none';this.nextElementSibling.style.display='grid';" />}
            <span class="fb" style={host ? 'display:none;' : ''}>{(tool?.Name || '?').charAt(0).toUpperCase()}</span>
          </div>
          <div>
            <div class="name">{tool?.Name}</div>
            <div class="cat">{tool?.tagline_pt || tool?.tagline_en || categoryName}</div>
          </div>
          <div class="price-tag">
            <b>{priceLabel(tool)}</b>
            <a href={tool?.affiliate_url || tool?.website} target="_blank" rel="noopener noreferrer" class="btn primary">Visitar →</a>
          </div>
        </div>
      </>
    ))}
  </div>

  <section class="verdict">
    <span class="badge">veredicto · qual escolher</span>
    <h2>Depende do seu contexto — aqui está o atalho.</h2>
    <div class="verdict-grid">
      {([toolA, toolB] as const).map((tool, i) => {
        const bullets = i === 0 ? bulletsA : bulletsB;
        return (
          <div class="pc">
            <h3>Escolha {tool?.Name} se…</h3>
            <ul>
              {bullets.map(b => (
                <li><span class="arr">→</span>{b}</li>
              ))}
            </ul>
          </div>
        );
      })}
    </div>
  </section>

  <section class="matrix">
    <div class="mx-head">
      <div class="label">Critério</div>
      <div><h4>{toolA?.Name}</h4></div>
      <div><h4>{toolB?.Name}</h4></div>
    </div>
    {criteria.map((c) => (
      <div class="mx-row">
        <div class="criterion">{c.label}</div>
        <div class="cell" style={'color:' + getColor(toolA, c)}>{formatValue(toolA, c)}</div>
        <div class="cell" style={'color:' + getColor(toolB, c)}>{formatValue(toolB, c)}</div>
      </div>
    ))}
  </section>

  <div class="two-col">
    {[toolA, toolB].filter(t => t?.latam_note_pt).map(tool => (
      <div class="note-card">
        <h3>{tool?.Name} no Brasil</h3>
        <p>{tool?.latam_note_pt}</p>
      </div>
    ))}
  </div>

  <div class="two-col">
    {[toolA, toolB].map(tool => (
      <div class="about-card">
        <h3>Sobre {tool?.Name}</h3>
        <p>{tool?.description_pt?.substring(0, 300)}...</p>
        <a href={'/tools/' + tool?.slug}>Ver ficha completa de {tool?.Name} →</a>
      </div>
    ))}
  </div>

  <div class="two-col" style="margin-bottom:0;">
    {[toolA, toolB].map(tool => (
      <div class="cta-card">
        <p>Pronto para experimentar {tool?.Name}?</p>
        <a href={tool?.affiliate_url || tool?.website} target="_blank" rel="noopener noreferrer" class="btn primary">Começar →</a>
      </div>
    ))}
  </div>
</Base>
